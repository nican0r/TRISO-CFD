#! Generated by src/make_case.py (Day 11-12 - Case V UTK/ORNL 3D CFD-DEM
#! spouted bed, built on the Day-10 R1 PIC geometry).
#! Coordinates: cartesian, cartesian_grid=.True., use_stl=.True.
#! Solids model: {{ solids_model }} (soft-sphere spring-dashpot DEM;
#! CGP mode selected when solids_model='CGP' with cgp_stat_wt(1) = {{ cgp_stat_wt }}).
#!
#! Day-11-12 build: reuses the Day-10 R1 NETL-clone pattern verbatim
#! (now uniform 1 mm Cartesian mesh under the Day-10 R4 refinement -- was
#! 2 mm; see the R4 section of notes/day10_summary.md -- full-face MI at
#! box bottom carved by the stub-cylinder STL, no cad_propagate_order /
#! set_corner_cells).  Swaps
#! solids_model(1) from 'PIC' to '{{ solids_model }}' and the Harris-Crighton
#! continuum stress block for the DEM spring-dashpot contact block
#! (kn, kn_w, kt_fac, kt_w_fac, mew, mew_w, des_en_input, des_en_wall_input,
#!  des_etat_fac, des_etat_w_fac).  See notes/day11_summary.md for the
#! DEM-vs-PIC coupling rationale.
#!
#! Every keyword below is confirmed against init_namelist.f,
#! cartesian_grid_init_namelist.f, and share/mfix/doc/html/reference/
#! discrete_element.html (MFiX 26.1.2) (CLAUDE.md rule 1).  Reference
#! template: /Users/nelsonpereira/mamba/envs/mfix-26.1.2/share/mfix/
#! templates/tutorials/dem/spouted_bed_pseudo_2d/spouted_bed_pseudo_2d.mfx
#! and tutorials/cgp/fluidbed_cgp_3d/fluidbed_cgp_3d.mfx.

### Run controls
  description = '{{ description }}'
  run_name    = '{{ run_name }}'
  units       = 'SI'
  run_type    = 'new'
  tstop       = {{ tstop_s }}
  dt          = {{ dt_s }}
  # DMP (MPI) decomposition.  nodesi * nodesj * nodesk MUST equal the MPI
  # rank count (mpirun -np N).  Defaults to 1x1x1 (serial).  Local MPI
  # smokes override via `src/run_V_3d_day11.py --nodes NI,NJ,NK`.  AWS
  # Batch runs through `docker/entrypoint.sh`, which strips these lines
  # and injects a matching decomposition based on the container's NP env
  # var -- so these keywords are set here only for local use and never
  # survive to the cluster deck.
  nodesi = {{ nodes_i }}
  nodesj = {{ nodes_j }}
  nodesk = {{ nodes_k }}
  dt_min      = 1.000000e-07
  dt_max      = {{ dt_max_s }}
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  drag_type   = '{{ drag_type }}'
  drag_c1     = 0.8
  drag_d1     = 2.65
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (watertight STL read from {{ stl_filename }}).
  cartesian_grid  = .True.
  use_stl         = .True.
  stl_small_angle = 0.0
  out_stl_value   = 1.0

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = {{ max_nit }}
  norm_g       = 0.0

### Geometry (cartesian 3D, uniform 1 mm mesh -- Day-10 R4 refinement)
  coordinates = 'CARTESIAN'
  imax        = {{ imax }}
  jmax        = {{ jmax }}
  kmax        = {{ kmax }}
  x_min       = {{ x_min_m }}
  x_max       = {{ x_max_m }}
  y_min       = {{ y_min_m }}
  y_max       = {{ H_dom_m }}
  z_min       = {{ z_min_m }}
  z_max       = {{ z_max_m }}
{%- for d in dx_m_list %}
  dx({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dy_m_list %}
  dy({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dz_m_list %}
  dz({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}

#### Fluid
  mu_g0      = {{ mu_g_pa_s }}
  mu_g_model = 'CONSTANT'
  ro_g0      = {{ rho_g_kg_m3 }}

#### Solids (CFD-DEM soft-sphere spring-dashpot)
  mmax = 1
  # Solid 1: ORNL/UTK Case V ZrO2 (500 um real particle, 6050 kg/m^3).
  # For CGP mode (solids_model='CGP'), MFiX scales each parcel's effective
  # diameter and mass internally from cgp_stat_wt; d_p0 and ro_s0 remain
  # the REAL particle values.
    solids_model(1) = '{{ solids_model }}'
    d_p0(1)         = {{ d_p_m }}
    ro_s0(1)        = {{ rho_p_kg_m3 }}
    nmax_s(1)       = 0
{%- if solids_model == 'CGP' %}
    cgp_stat_wt(1)  = {{ cgp_stat_wt }}
{%- endif %}

### Initial conditions
  # IC 1: Whole domain, gas-only (MFiX multi-IC requirement; see Day-10
  # template_dem.mfx.j2 header comment).
    ic_x_w(1)    = {{ x_min_m }}
    ic_x_e(1)    = {{ x_max_m }}
    ic_y_s(1)    = {{ y_min_m }}
    ic_y_n(1)    = {{ H_dom_m }}
    ic_z_b(1)    = {{ z_min_m }}
    ic_z_t(1)    = {{ z_max_m }}
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 293.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = 293.15
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2-5: Packed bed, 0 <= y <= H_static, split into NETL's 4-quadrant
  # pattern that leaves a central gas-only column of half-width
  # R_bed_gas_col = {{ "%.4f"|format(R_bed_gas_col_m) }} m untouched (filled by IC_1).
  # Replaces Day-10 R2's single full-box IC_2; see
  # notes/day10_pathology_review.md for why.  Each strip carries the
  # DEM/CGP lattice keys so particles seed only in the packed strips.
  #
  # IC 2: +z bed strip, full x extent above R_bed_gas_col.
    ic_x_w(2)    = {{ x_min_m }}
    ic_x_e(2)    = {{ x_max_m }}
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = {{ H_static_m }}
    ic_z_b(2)    = {{ R_bed_gas_col_m }}
    ic_z_t(2)    = {{ z_max_m }}
    ic_ep_g(2)   = {{ ep_g_bed }}
    ic_t_g(2)    = 293.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = {{ eps_s_bed }}
    ic_t_s(2,1)  = 293.15
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0
    ic_des_lattice(2,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(2,1) = .False.
    ic_des_tight_boundary_spacing(2,1) = .True.
    ic_des_spacing(2,1) = 0.05

  # IC 3: -z bed strip, full x extent below -R_bed_gas_col.
    ic_x_w(3)    = {{ x_min_m }}
    ic_x_e(3)    = {{ x_max_m }}
    ic_y_s(3)    = 0.0
    ic_y_n(3)    = {{ H_static_m }}
    ic_z_b(3)    = {{ z_min_m }}
    ic_z_t(3)    = {{ "%.6e"|format(-R_bed_gas_col_m) }}
    ic_ep_g(3)   = {{ ep_g_bed }}
    ic_t_g(3)    = 293.15
    ic_u_g(3)    = 0.0
    ic_v_g(3)    = 0.0
    ic_w_g(3)    = 0.0
    ic_ep_s(3,1) = {{ eps_s_bed }}
    ic_t_s(3,1)  = 293.15
    ic_theta_m(3,1) = 0.0
    ic_u_s(3,1)  = 0.0
    ic_v_s(3,1)  = 0.0
    ic_w_s(3,1)  = 0.0
    ic_des_lattice(3,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(3,1) = .False.
    ic_des_tight_boundary_spacing(3,1) = .True.
    ic_des_spacing(3,1) = 0.05

  # IC 4: -x center bed strip, between the +/-z strips, left of -R_bed_gas_col.
    ic_x_w(4)    = {{ x_min_m }}
    ic_x_e(4)    = {{ "%.6e"|format(-R_bed_gas_col_m) }}
    ic_y_s(4)    = 0.0
    ic_y_n(4)    = {{ H_static_m }}
    ic_z_b(4)    = {{ "%.6e"|format(-R_bed_gas_col_m) }}
    ic_z_t(4)    = {{ R_bed_gas_col_m }}
    ic_ep_g(4)   = {{ ep_g_bed }}
    ic_t_g(4)    = 293.15
    ic_u_g(4)    = 0.0
    ic_v_g(4)    = 0.0
    ic_w_g(4)    = 0.0
    ic_ep_s(4,1) = {{ eps_s_bed }}
    ic_t_s(4,1)  = 293.15
    ic_theta_m(4,1) = 0.0
    ic_u_s(4,1)  = 0.0
    ic_v_s(4,1)  = 0.0
    ic_w_s(4,1)  = 0.0
    ic_des_lattice(4,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(4,1) = .False.
    ic_des_tight_boundary_spacing(4,1) = .True.
    ic_des_spacing(4,1) = 0.05

  # IC 5: +x center bed strip, between the +/-z strips, right of +R_bed_gas_col.
    ic_x_w(5)    = {{ R_bed_gas_col_m }}
    ic_x_e(5)    = {{ x_max_m }}
    ic_y_s(5)    = 0.0
    ic_y_n(5)    = {{ H_static_m }}
    ic_z_b(5)    = {{ "%.6e"|format(-R_bed_gas_col_m) }}
    ic_z_t(5)    = {{ R_bed_gas_col_m }}
    ic_ep_g(5)   = {{ ep_g_bed }}
    ic_t_g(5)    = 293.15
    ic_u_g(5)    = 0.0
    ic_v_g(5)    = 0.0
    ic_w_g(5)    = 0.0
    ic_ep_s(5,1) = {{ eps_s_bed }}
    ic_t_s(5,1)  = 293.15
    ic_theta_m(5,1) = 0.0
    ic_u_s(5,1)  = 0.0
    ic_v_s(5,1)  = 0.0
    ic_w_s(5,1)  = 0.0
    ic_des_lattice(5,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(5,1) = .False.
    ic_des_tight_boundary_spacing(5,1) = .True.
    ic_des_spacing(5,1) = 0.05

  # Inlet stub region (y in [-L_stub, 0]) is covered by IC_1 (gas,
  # v_g=0) -- Day-10 R2's explicit IC_3 was redundant and has been
  # dropped as part of Fix A.

# Boundary conditions
  # BC 1: Cut-cell (STL) no-slip wall.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: Pressure-outflow at the top (y = H_dom).
    bc_type(2) = 'PO'
    bc_x_w(2)  = {{ x_min_m }}
    bc_x_e(2)  = {{ x_max_m }}
    bc_y_s(2)  = {{ H_dom_m }}
    bc_y_n(2)  = {{ H_dom_m }}
    bc_z_b(2)  = {{ z_min_m }}
    bc_z_t(2)  = {{ z_max_m }}
    bc_p_g(2)  = 101325

  # BC 3: Mass-inflow at the box bottom (y = -L_stub), full face; STL
  # stub cylinder (radius R_stub) carves the inflow to the stub-tube
  # cross-section.  Day-10 R4 refinement: R_stub = R_i (straight 4 mm pipe,
  # no widening) and bc_v_g = U_in_m_s directly -- no (R_i/R_stub)^2
  # scaling, because the 1 mm mesh resolves R_i = 2 mm with 2 cells
  # across the radius (F_AT fluid-classed) without the R2 Option-4
  # widening hack.
    bc_type(3) = 'MI'
    bc_x_w(3)  = {{ bc_mi_x_w_m }}
    bc_x_e(3)  = {{ bc_mi_x_e_m }}
    bc_y_s(3)  = {{ bc_mi_y_s_m }}
    bc_y_n(3)  = {{ bc_mi_y_n_m }}
    bc_z_b(3)  = {{ bc_mi_z_b_m }}
    bc_z_t(3)  = {{ bc_mi_z_t_m }}
    bc_ep_g(3) = 1.0
    bc_p_g(3)  = 101325
    bc_t_g(3)  = 293.15
    bc_u_g(3)  = 0.0
    bc_v_g(3)  = {{ bc_v_g_mi_m_s }}
    bc_w_g(3)  = 0.0
    bc_ep_s(3,1) = 0.0
    bc_t_s(3,1)  = 293.15
    bc_u_s(3,1)  = 0.0
    bc_v_s(3,1)  = 0.0
    bc_w_s(3,1)  = 0.0

  bc_default_walls = .True.

# Monitors (1 kHz sampling, same scheme as Day-10 PIC).
  # Monitor 1: inlet-plane gas pressure.
    monitor_type(1) = 4
    monitor_name(1) = 'V_3d_dem_P_inlet'
    monitor_x_w(1)  = {{ orifice_x_w_m }}
    monitor_x_e(1)  = {{ orifice_x_e_m }}
    monitor_y_s(1)  = 0.0
    monitor_y_n(1)  = {{ dy_min_m }}
    monitor_z_b(1)  = {{ orifice_z_b_m }}
    monitor_z_t(1)  = {{ orifice_z_t_m }}
    monitor_dt(1)   = {{ monitor_dt_s }}
    monitor_p_g(1)  = .True.

  # Monitor 2: top-of-bed gas pressure.
    monitor_type(2) = 4
    monitor_name(2) = 'V_3d_dem_P_top_bed'
    monitor_x_w(2)  = {{ x_min_m }}
    monitor_x_e(2)  = {{ x_max_m }}
    monitor_y_s(2)  = {{ H_static_m }}
    monitor_y_n(2)  = {{ "%.6e"|format(H_static_m + dy_min_m) }}
    monitor_z_b(2)  = {{ z_min_m }}
    monitor_z_t(2)  = {{ z_max_m }}
    monitor_dt(2)   = {{ monitor_dt_s }}
    monitor_p_g(2)  = .True.

  # Monitor 3: domain-integrated solids inventory (volume integral of
  # the Eulerian ep_s mean field; des_interp_mean_fields=.True. projects
  # DEM particle mass to the grid).
    monitor_type(3) = 11
    monitor_name(3) = 'V_3d_dem_solids_inventory'
    monitor_x_w(3)  = {{ x_min_m }}
    monitor_x_e(3)  = {{ x_max_m }}
    monitor_y_s(3)  = 0.0
    monitor_y_n(3)  = {{ H_dom_m }}
    monitor_z_b(3)  = {{ z_min_m }}
    monitor_z_t(3)  = {{ z_max_m }}
    monitor_dt(3)   = {{ monitor_dt_s }}
    monitor_ep_s(3,1) = .True.

  # Monitor 4: centerline gas velocity probe at mid-bed height.
    monitor_type(4) = 4
    monitor_name(4) = 'V_3d_dem_centerline_vg'
    monitor_x_w(4)  = {{ orifice_x_w_m }}
    monitor_x_e(4)  = {{ orifice_x_e_m }}
    monitor_y_s(4)  = {{ H_mid_m }}
    monitor_y_n(4)  = {{ "%.6e"|format(H_mid_m + dy_min_m) }}
    monitor_z_b(4)  = {{ orifice_z_b_m }}
    monitor_z_t(4)  = {{ orifice_z_t_m }}
    monitor_dt(4)   = {{ monitor_dt_s }}
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: whole domain cell-centred EP_G / P_G / Gas_Velocity.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = {{ x_min_m }}
    vtk_x_e(1)      = {{ x_max_m }}
    vtk_y_s(1)      = {{ y_min_m }}
    vtk_y_n(1)      = {{ H_dom_m }}
    vtk_z_b(1)      = {{ z_min_m }}
    vtk_z_t(1)      = {{ z_max_m }}
    vtk_data(1)     = 'C'
    vtk_dt(1)       = {{ vtk_dt_s }}
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: particle positions / diameter / velocity / id.  vtk_part_id
  # is required for residence-time tracking across frames.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = {{ x_min_m }}
    vtk_x_e(2)           = {{ x_max_m }}
    vtk_y_s(2)           = {{ y_min_m }}
    vtk_y_n(2)           = {{ H_dom_m }}
    vtk_z_b(2)           = {{ z_min_m }}
    vtk_z_t(2)           = {{ z_max_m }}
    vtk_data(2)          = 'P'
    vtk_dt(2)            = {{ vtk_dt_s }}
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.
    vtk_part_id(2)       = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block (gas->parcel interpolation and parcel seeding).
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = '{{ des_interp_scheme }}'
  gener_part_config      = .True.
  des_oneway_coupled     = .False.
  des_epg_clip           = {{ des_epg_clip }}

### DEM contact block (soft-sphere linear spring-dashpot with Coulomb
### tangential cap).  Confirmed against share/mfix/doc/html/reference/
### discrete_element.html (MFiX 26.1.2).
  kn                   = {{ kn }}
  kn_w                 = {{ kn_w }}
  kt_fac               = {{ kt_fac }}
  kt_w_fac             = {{ kt_w_fac }}
  mew                  = {{ mew }}
  mew_w                = {{ mew_w }}
  des_en_input(1)      = {{ des_en_input_pp }}
  des_en_wall_input(1) = {{ des_en_input_pw }}
  des_etat_fac         = {{ des_etat_fac }}
  des_etat_w_fac       = {{ des_etat_w_fac }}
