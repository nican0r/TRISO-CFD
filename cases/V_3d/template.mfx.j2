#! Generated by src/make_case.py (Day 10 - Case V UTK/ORNL 3D PIC spouted bed).
#! Coordinates: cartesian, cartesian_grid=.True., use_stl=.True.
#! Solids model: PIC (MP-PIC / Harris-Crighton).
#!
#! The vessel inner wall (surface of revolution: 60 deg cone + straight
#! cylindrical column, 4 mm constant-diameter orifice at the apex, extended
#! downward by a short cylindrical stub of radius R_i so the MI BC sits at
#! the Cartesian box bottom) is read from an ASCII STL at
#! `{{ stl_filename }}` (generated by src/make_stl.py's implicit-boolean +
#! marching-cubes path for a watertight shell).  MFiX 26.1.2 expects a
#! per-BC STL named `geometry_<4-digit BC>.stl` for each CG_ boundary
#! (cartesian_grid/get_stl_data.f lines 678-701); BC 1 is the CG_NSW
#! wall, so the file name is `geometry_0001.stl`.
#!
#! Mesh is graded in x and z (segments 5 x 4.6 mm | 4 x 1 mm | 5 x 4.6 mm)
#! so the orifice spans at least 4 cells with cell size <= 1 mm near the
#! axis (Day-10 rule), and cell size stays <= 10*d_p = 5 mm elsewhere in
#! the particle zone.  y is graded 5 x 2 mm (stub) | 20 x 2 mm (bed) |
#! 20 x 4 mm (fountain) | 16 x 5 mm (freeboard).
#!
#! Why PIC on this geometry (recorded in notes/day10_summary.md).  MFiX
#! 26.1.2's STL cut-cell F_AT classifier (cartesian_grid/intersect.f) has
#! a near-axis mis-classification bug for an open-top surface-of-revolution
#! STL: corners far from any facet remain UNDEFINED and get marked BLOCKED,
#! so the TFM volume-fraction advection cannot carry solids through the
#! near-axis spout column.  Three fix attempts (cad_propagate_order='JKI'
#! + set_corner_cells, inlet-stub-tube topology, dense watertight STL via
#! implicit-boolean sampling) were all tried on the TFM path and ruled out:
#! the bug is in the Cartesian-grid cut-cell classifier, not in anything
#! the input deck can control.  PIC sidesteps the F_AT dependency by
#! tracking parcels in continuous space and interpolating to/from the
#! grid (see NETL tutorials/pic/spouted_bed_3d/spouted_bed_pic_3d.mfx);
#! it also avoids the LUN_1984 PDE stiffness that ended the quadric
#! TFM attempt.  PIC is NETL's documented recommended path for 3D
#! spouted beds and the wall-clock is ~1.5-3x TFM (far below CFD-DEM).
#!
#! Every keyword below has been confirmed against init_namelist.f,
#! cartesian_grid_init_namelist.f, and the installed MFiX 26.1.2 keyword
#! reference under share/mfix/doc/html/reference/particle_in_cell.html,
#! initial_condition.html, boundary_condition.html, and
#! discrete_element.html (CLAUDE.md rule 1).

### Run controls
  description = '{{ description }}'
  run_name    = '{{ run_name }}'
  units       = 'SI'
  run_type    = 'new'
  tstop       = {{ tstop_s }}
  dt          = {{ dt_s }}
  dt_min      = 1.000000e-07
  dt_max      = {{ dt_max_s }}
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  drag_type   = '{{ drag_type }}'
  drag_c1     = 0.8
  drag_d1     = 2.65
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (watertight STL read from {{ stl_filename }}).
### For PIC, F_AT propagation is not load-bearing (parcels live in
### continuous space), but keep cad_propagate_order/set_corner_cells on
### for a clean fluid-cell map that the gas phase still needs.
  cartesian_grid  = .True.
  use_stl         = .True.
  stl_small_angle = 0.0
  out_stl_value   = 1.0
  cad_propagate_order = 'JKI'
  set_corner_cells    = .True.

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = {{ max_nit }}
  norm_g       = 0.0

### Geometry (cartesian 3D with per-cell dx/dy/dz grading)
  coordinates = 'CARTESIAN'
  imax        = {{ imax }}
  jmax        = {{ jmax }}
  kmax        = {{ kmax }}
  x_min       = {{ x_min_m }}
  x_max       = {{ x_max_m }}
  y_min       = {{ y_min_m }}
  y_max       = {{ H_dom_m }}
  z_min       = {{ z_min_m }}
  z_max       = {{ z_max_m }}
{%- for d in dx_m_list %}
  dx({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dy_m_list %}
  dy({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dz_m_list %}
  dz({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}

#### Fluid
  mu_g0      = {{ mu_g_pa_s }}
  mu_g_model = 'CONSTANT'
  ro_g0      = {{ rho_g_kg_m3 }}

#### Solids (PIC: Harris-Crighton continuum solids stress)
  mmax = 1
  # Solid 1: ORNL/UTK Case V ZrO2 (500 um, 6050 kg/m^3)
    solids_model(1) = 'PIC'
    d_p0(1)         = {{ d_p_m }}
    ro_s0(1)        = {{ rho_p_kg_m3 }}
    nmax_s(1)       = 0

### Initial conditions
  # IC 1: Freeboard (gas only, above the packed bed).  No parcels.
    ic_x_w(1)    = {{ x_min_m }}
    ic_x_e(1)    = {{ x_max_m }}
    ic_y_s(1)    = {{ H_static_m }}
    ic_y_n(1)    = {{ H_dom_m }}
    ic_z_b(1)    = {{ z_min_m }}
    ic_z_t(1)    = {{ z_max_m }}
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 293.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_ep_s(1,1) = 0.0
    ic_pic_const_statwt(1,1) = {{ ic_pic_const_statwt }}
    ic_t_s(1,1)  = 293.15
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: Packed bed, 0 <= y <= H_static.  PIC generates parcels inside
  # this box at startup from ic_ep_s + ic_pic_const_statwt; cut-cells trim
  # to the cone frustum via the STL.  eps_s_bed = {{ eps_s_bed }} sits
  # below eps_s_max = 1 - des_epg_clip = {{ "%.2f"|format(1.0 - des_epg_clip) }} so the
  # Harris-Crighton frictional stress is inactive at t = 0.
    ic_x_w(2)    = {{ x_min_m }}
    ic_x_e(2)    = {{ x_max_m }}
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = {{ H_static_m }}
    ic_z_b(2)    = {{ z_min_m }}
    ic_z_t(2)    = {{ z_max_m }}
    ic_ep_g(2)   = {{ ep_g_bed }}
    ic_t_g(2)    = 293.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = {{ eps_s_bed }}
    ic_pic_const_statwt(2,1) = {{ ic_pic_const_statwt }}
    ic_t_s(2,1)  = 293.15
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0

  # IC 3: Pre-opened spout channel, |x|<=R_i, |z|<=R_i through the bed.
  # Gas-only column (seed the jet, no parcels).
    ic_x_w(3)    = {{ bc_mi_x_w_m }}
    ic_x_e(3)    = {{ bc_mi_x_e_m }}
    ic_y_s(3)    = 0.0
    ic_y_n(3)    = {{ H_static_m }}
    ic_z_b(3)    = {{ bc_mi_z_b_m }}
    ic_z_t(3)    = {{ bc_mi_z_t_m }}
    ic_ep_g(3)   = 1.0
    ic_t_g(3)    = 293.15
    ic_u_g(3)    = 0.0
    ic_v_g(3)    = {{ U_in_m_s }}
    ic_w_g(3)    = 0.0
    ic_p_g(3)    = 101325.0
    ic_ep_s(3,1) = 0.0
    ic_pic_const_statwt(3,1) = {{ ic_pic_const_statwt }}
    ic_t_s(3,1)  = 293.15
    ic_theta_m(3,1) = 0.0
    ic_u_s(3,1)  = 0.0
    ic_v_s(3,1)  = 0.0
    ic_w_s(3,1)  = 0.0

  # IC 4: Inlet stub tube region (gas-only, upward flow, y in [-L_stub, 0]).
  # Sits BELOW the cone orifice; connects MI at y = -L_stub to the vessel
  # interior at y = 0.  Spans the full box x,z extent; STL cut-cell
  # preprocessing blocks cells outside the stub-tube cylinder (r > R_i).
    ic_x_w(4)    = {{ x_min_m }}
    ic_x_e(4)    = {{ x_max_m }}
    ic_y_s(4)    = {{ y_min_m }}
    ic_y_n(4)    = 0.0
    ic_z_b(4)    = {{ z_min_m }}
    ic_z_t(4)    = {{ z_max_m }}
    ic_ep_g(4)   = 1.0
    ic_t_g(4)    = 293.15
    ic_u_g(4)    = 0.0
    ic_v_g(4)    = {{ U_in_m_s }}
    ic_w_g(4)    = 0.0
    ic_p_g(4)    = 101325.0
    ic_ep_s(4,1) = 0.0
    ic_pic_const_statwt(4,1) = {{ ic_pic_const_statwt }}
    ic_t_s(4,1)  = 293.15
    ic_theta_m(4,1) = 0.0
    ic_u_s(4,1)  = 0.0
    ic_v_s(4,1)  = 0.0
    ic_w_s(4,1)  = 0.0

# Boundary conditions
  # BC 1: Cut-cell (STL) no-slip wall.  First CG_NSW BC with no region
  # bounds is applied to all cut-cells.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: Pressure-outflow at the top (y = H_dom), full x,z extent.
    bc_type(2) = 'PO'
    bc_x_w(2)  = {{ x_min_m }}
    bc_x_e(2)  = {{ x_max_m }}
    bc_y_s(2)  = {{ H_dom_m }}
    bc_y_n(2)  = {{ H_dom_m }}
    bc_z_b(2)  = {{ z_min_m }}
    bc_z_t(2)  = {{ z_max_m }}
    bc_p_g(2)  = 101325

  # BC 3: Mass-inflow at the box bottom (y = -L_stub), across the
  # orifice-bounding square |x|<=R_i, |z|<=R_i.  STL cut-cell masks the
  # square to the circular stub-tube footprint.  Gas-only inlet
  # (bc_ep_s(3,1)=0.0); bc_pic_mi_const_statwt is set but no parcels
  # actually enter via this BC.
    bc_type(3) = 'MI'
    bc_x_w(3)  = {{ bc_mi_x_w_m }}
    bc_x_e(3)  = {{ bc_mi_x_e_m }}
    bc_y_s(3)  = {{ bc_mi_y_s_m }}
    bc_y_n(3)  = {{ bc_mi_y_n_m }}
    bc_z_b(3)  = {{ bc_mi_z_b_m }}
    bc_z_t(3)  = {{ bc_mi_z_t_m }}
    bc_ep_g(3) = 1.0
    bc_p_g(3)  = 101325
    bc_t_g(3)  = 293.15
    bc_u_g(3)  = 0.0
    bc_v_g(3)  = {{ U_in_m_s }}
    bc_w_g(3)  = 0.0
    bc_ep_s(3,1) = 0.0
    bc_pic_mi_const_statwt(3,1) = {{ bc_pic_mi_const_statwt }}
    bc_t_s(3,1)  = 293.15
    bc_u_s(3,1)  = 0.0
    bc_v_s(3,1)  = 0.0
    bc_w_s(3,1)  = 0.0

  bc_default_walls = .True.

# Monitors (1 kHz sampling matches S1 and S2's 1000 Hz experimental sampling).
# monitor_type=4 ("arithmetic average over region (cell)") needs non-zero
# volume; plane monitors (y_s=y_n) return zero-volume cells and MFiX
# writes the undefined sentinel.  Each plane monitor is extended over one
# dy_min_m-thick slab so the volume is finite.
  # Monitor 1: inlet-plane gas pressure.
    monitor_type(1) = 4
    monitor_name(1) = 'V_3d_P_inlet'
    monitor_x_w(1)  = {{ bc_mi_x_w_m }}
    monitor_x_e(1)  = {{ bc_mi_x_e_m }}
    monitor_y_s(1)  = 0.0
    monitor_y_n(1)  = {{ dy_min_m }}
    monitor_z_b(1)  = {{ bc_mi_z_b_m }}
    monitor_z_t(1)  = {{ bc_mi_z_t_m }}
    monitor_dt(1)   = {{ monitor_dt_s }}
    monitor_p_g(1)  = .True.

  # Monitor 2: top-of-bed gas pressure.
    monitor_type(2) = 4
    monitor_name(2) = 'V_3d_P_top_bed'
    monitor_x_w(2)  = {{ x_min_m }}
    monitor_x_e(2)  = {{ x_max_m }}
    monitor_y_s(2)  = {{ H_static_m }}
    monitor_y_n(2)  = {{ "%.6e"|format(H_static_m + dy_min_m) }}
    monitor_z_b(2)  = {{ z_min_m }}
    monitor_z_t(2)  = {{ z_max_m }}
    monitor_dt(2)   = {{ monitor_dt_s }}
    monitor_p_g(2)  = .True.

  # Monitor 3: domain-integrated solids inventory (volume integral of
  # the Eulerian ep_s mean field; PIC projects parcel mass to the grid
  # via DES_INTERP_MEAN_FIELDS=.True., so MONITOR_EP_S is valid).
    monitor_type(3) = 11
    monitor_name(3) = 'V_3d_solids_inventory'
    monitor_x_w(3)  = {{ x_min_m }}
    monitor_x_e(3)  = {{ x_max_m }}
    monitor_y_s(3)  = 0.0
    monitor_y_n(3)  = {{ H_dom_m }}
    monitor_z_b(3)  = {{ z_min_m }}
    monitor_z_t(3)  = {{ z_max_m }}
    monitor_dt(3)   = {{ monitor_dt_s }}
    monitor_ep_s(3,1) = .True.

  # Monitor 4: centerline gas velocity probe at mid-bed height (y = H_mid).
    monitor_type(4) = 4
    monitor_name(4) = 'V_3d_centerline_vg'
    monitor_x_w(4)  = {{ bc_mi_x_w_m }}
    monitor_x_e(4)  = {{ bc_mi_x_e_m }}
    monitor_y_s(4)  = {{ H_mid_m }}
    monitor_y_n(4)  = {{ "%.6e"|format(H_mid_m + dy_min_m) }}
    monitor_z_b(4)  = {{ bc_mi_z_b_m }}
    monitor_z_t(4)  = {{ bc_mi_z_t_m }}
    monitor_dt(4)   = {{ monitor_dt_s }}
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: whole domain cell-centred EP_G / P_G / Gas_Velocity.  PIC
  # projects parcel mass to the Eulerian mean fields so EP_G carries the
  # 1 - ep_s information even without a Solids_Velocity cell field.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = {{ x_min_m }}
    vtk_x_e(1)      = {{ x_max_m }}
    vtk_y_s(1)      = 0.0
    vtk_y_n(1)      = {{ H_dom_m }}
    vtk_z_b(1)      = {{ z_min_m }}
    vtk_z_t(1)      = {{ z_max_m }}
    vtk_data(1)     = 'C'
    vtk_dt(1)       = {{ vtk_dt_s }}
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: parcel positions, diameter, velocity (data='P' = particles).
  # PIC parcels are tracked in continuous space; dump them as a point-
  # cloud VTP so Day 11-12 CFD-DEM comparisons can reuse the same
  # post-processor path.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = {{ x_min_m }}
    vtk_x_e(2)           = {{ x_max_m }}
    vtk_y_s(2)           = {{ y_min_m }}
    vtk_y_n(2)           = {{ H_dom_m }}
    vtk_z_b(2)           = {{ z_min_m }}
    vtk_z_t(2)           = {{ z_max_m }}
    vtk_data(2)          = 'P'
    vtk_dt(2)            = {{ vtk_dt_s }}
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only -- PIC has no solids residual to monitor).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block (shared by PIC: gas->parcel interpolation and
### initial parcel generation from the IC_PIC_CONST_STATWT fields).
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = '{{ des_interp_scheme }}'
  gener_part_config      = .True.

### Shared solids-stress knob (used by PIC through its continuum stress).
### des_epg_clip is the minimum gas volume fraction used in drag/stress
### evaluation; NETL ships 0.42 as the PIC tutorial default and Case V's
### ep_star = 0.42 happens to match it identically (physics coincidence,
### both describing the min-fluidization void fraction).
  des_epg_clip   = {{ des_epg_clip }}
  friction_model = '{{ friction_model }}'

### Particle-in-cell model (Harris-Crighton continuum closure parameters,
### from NETL tutorials/pic/spouted_bed_3d/spouted_bed_pic_3d.mfx).
  fric_exp_pic        = {{ fric_exp_pic }}
  fric_non_sing_fac   = {{ fric_non_sing_fac }}
  mppic_coeff_en1     = {{ mppic_coeff_en1 }}
  mppic_coeff_en_wall = {{ mppic_coeff_en_wall }}
  mppic_coeff_et_wall = {{ mppic_coeff_et_wall }}
  mppic_velfac_coeff  = {{ mppic_velfac_coeff }}
  psfac_fric_pic      = {{ psfac_fric_pic }}
