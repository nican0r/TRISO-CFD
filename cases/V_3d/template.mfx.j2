#! Generated by src/make_case.py (Day 10 R1 - Case V UTK/ORNL 3D PIC
#! spouted bed, NETL-clone redesign).
#! Coordinates: cartesian, cartesian_grid=.True., use_stl=.True.
#! Solids model: PIC (MP-PIC / Harris-Crighton).
#!
#! Day-10 R1 (NETL-clone pattern): uniform 2 mm Cartesian mesh, full-face
#! MI at the box bottom, no cad_propagate_order / set_corner_cells, stub
#! cylinder of radius R_i extends to y = -L_stub as the physical orifice-
#! equivalent.  See notes/day10_summary.md ("R1 - NETL-clone redesign")
#! for the F_AT trap that this layout avoids: on the first attempt the
#! graded mesh (1 mm near-axis, 4.6 mm outer) + dense STL + tiny orifice-
#! aligned MI triggered the MFiX 26.1.2 F_AT cut-cell classifier bug,
#! BLOCKING the near-axis fine cells and preventing spout formation.
#!
#! The vessel inner wall (60 deg cone + straight cylindrical column + a
#! stub cylinder of radius R_i extending from y = -L_stub to y = 0) is
#! read from an ASCII STL at `{{ stl_filename }}` (generated by
#! src/make_stl.build_spouted_bed_stl_implicit's SDF + marching-cubes
#! path for a watertight shell).  MFiX 26.1.2 expects a per-BC STL named
#! `geometry_<4-digit BC>.stl` for each CG_ boundary
#! (cartesian_grid/get_stl_data.f lines 678-701); BC 1 is the CG_NSW
#! wall, so the file name is `geometry_0001.stl`.
#!
#! Mesh is UNIFORM 2 mm in x, y, z (99 000 cells total).  Per NETL's
#! shipped tutorials/pic/spouted_bed_3d, uniform meshes avoid the
#! classifier bug that fine-cell grading can trigger; the 2 cells across
#! the 4 mm orifice is the same cell-to-radius ratio NETL uses for its
#! 15 mm spout (acceptable trade-off vs the "4 cells across inlet" rule).
#!
#! Every keyword below has been confirmed against init_namelist.f,
#! cartesian_grid_init_namelist.f, and the installed MFiX 26.1.2 keyword
#! reference under share/mfix/doc/html/reference/particle_in_cell.html,
#! initial_condition.html, boundary_condition.html, and
#! discrete_element.html (CLAUDE.md rule 1).

### Run controls
  description = '{{ description }}'
  run_name    = '{{ run_name }}'
  units       = 'SI'
  run_type    = 'new'
  tstop       = {{ tstop_s }}
  dt          = {{ dt_s }}
  dt_min      = 1.000000e-07
  dt_max      = {{ dt_max_s }}
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  drag_type   = '{{ drag_type }}'
  drag_c1     = 0.8
  drag_d1     = 2.65
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (watertight STL read from {{ stl_filename }}).
### Day-10 R1 NETL-clone: no cad_propagate_order or set_corner_cells
### (NETL's shipped tutorials/pic/spouted_bed_3d does not set them;
### they interact pathologically with graded meshes and dense STL).
  cartesian_grid  = .True.
  use_stl         = .True.
  stl_small_angle = 0.0
  out_stl_value   = 1.0

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = {{ max_nit }}
  norm_g       = 0.0

### Geometry (cartesian 3D with per-cell dx/dy/dz grading)
  coordinates = 'CARTESIAN'
  imax        = {{ imax }}
  jmax        = {{ jmax }}
  kmax        = {{ kmax }}
  x_min       = {{ x_min_m }}
  x_max       = {{ x_max_m }}
  y_min       = {{ y_min_m }}
  y_max       = {{ H_dom_m }}
  z_min       = {{ z_min_m }}
  z_max       = {{ z_max_m }}
{%- for d in dx_m_list %}
  dx({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dy_m_list %}
  dy({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dz_m_list %}
  dz({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}

#### Fluid
  mu_g0      = {{ mu_g_pa_s }}
  mu_g_model = 'CONSTANT'
  ro_g0      = {{ rho_g_kg_m3 }}

#### Solids (PIC: Harris-Crighton continuum solids stress)
  mmax = 1
  # Solid 1: ORNL/UTK Case V ZrO2 (500 um, 6050 kg/m^3)
    solids_model(1) = 'PIC'
    d_p0(1)         = {{ d_p_m }}
    ro_s0(1)        = {{ rho_p_kg_m3 }}
    nmax_s(1)       = 0

### Initial conditions
  # IC 1: Whole domain, gas-only.  Required by MFiX for multi-IC PIC runs
  # (MFiX error 1003 in check_data/check_ic_common_discrete.f:156 fires if
  # IC_1 does not span the entire box with ic_ep_g(1)=1.0).  Sub-region ICs
  # (IC_2 bed, IC_3 stub tube) override within their boxes.
    ic_x_w(1)    = {{ x_min_m }}
    ic_x_e(1)    = {{ x_max_m }}
    ic_y_s(1)    = {{ y_min_m }}
    ic_y_n(1)    = {{ H_dom_m }}
    ic_z_b(1)    = {{ z_min_m }}
    ic_z_t(1)    = {{ z_max_m }}
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 293.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_ep_s(1,1) = 0.0
    ic_pic_const_statwt(1,1) = {{ ic_pic_const_statwt }}
    ic_t_s(1,1)  = 293.15
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: Packed bed, 0 <= y <= H_static.  PIC generates parcels inside
  # this box at startup from ic_ep_s + ic_pic_const_statwt; cut-cells trim
  # to the cone frustum via the STL.  eps_s_bed = {{ eps_s_bed }} sits
  # below eps_s_max = 1 - des_epg_clip = {{ "%.2f"|format(1.0 - des_epg_clip) }} so the
  # Harris-Crighton frictional stress is inactive at t = 0.
    ic_x_w(2)    = {{ x_min_m }}
    ic_x_e(2)    = {{ x_max_m }}
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = {{ H_static_m }}
    ic_z_b(2)    = {{ z_min_m }}
    ic_z_t(2)    = {{ z_max_m }}
    ic_ep_g(2)   = {{ ep_g_bed }}
    ic_t_g(2)    = 293.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = {{ eps_s_bed }}
    ic_pic_const_statwt(2,1) = {{ ic_pic_const_statwt }}
    ic_t_s(2,1)  = 293.15
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0

  # IC 3: Inlet stub tube region (gas-only, y in [-L_stub, 0]).  Sits
  # BELOW the cone orifice; the STL stub cylinder (radius R_i) blocks all
  # cells outside r > R_i.  v_g = 0 at t = 0 (matches NETL's norm_g=0 /
  # all-ic-v_g=0 pattern); BC_3 (MI across full box bottom) drives the
  # inlet jet from t=0 forward.
  # Note: NETL's pic/spouted_bed_3d does not include a pre-opened spout
  # IC in the bed; the inlet jet carves the spout dynamically through the
  # packed parcels.  The TFM-era pre-opened spout IC was removed because
  # (a) it conflicts with PIC parcel seeding in the same column and (b)
  # NETL does not use it.
    ic_x_w(3)    = {{ x_min_m }}
    ic_x_e(3)    = {{ x_max_m }}
    ic_y_s(3)    = {{ y_min_m }}
    ic_y_n(3)    = 0.0
    ic_z_b(3)    = {{ z_min_m }}
    ic_z_t(3)    = {{ z_max_m }}
    ic_ep_g(3)   = 1.0
    ic_t_g(3)    = 293.15
    ic_u_g(3)    = 0.0
    ic_v_g(3)    = 0.0
    ic_w_g(3)    = 0.0
    ic_p_g(3)    = 101325.0
    ic_ep_s(3,1) = 0.0
    ic_pic_const_statwt(3,1) = {{ ic_pic_const_statwt }}
    ic_t_s(3,1)  = 293.15
    ic_theta_m(3,1) = 0.0
    ic_u_s(3,1)  = 0.0
    ic_v_s(3,1)  = 0.0
    ic_w_s(3,1)  = 0.0

# Boundary conditions
  # BC 1: Cut-cell (STL) no-slip wall.  First CG_NSW BC with no region
  # bounds is applied to all cut-cells.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: Pressure-outflow at the top (y = H_dom), full x,z extent.
    bc_type(2) = 'PO'
    bc_x_w(2)  = {{ x_min_m }}
    bc_x_e(2)  = {{ x_max_m }}
    bc_y_s(2)  = {{ H_dom_m }}
    bc_y_n(2)  = {{ H_dom_m }}
    bc_z_b(2)  = {{ z_min_m }}
    bc_z_t(2)  = {{ z_max_m }}
    bc_p_g(2)  = 101325

  # BC 3: Mass-inflow at the box bottom (y = -L_stub).  Day-10 R1 NETL
  # pattern: the MI spans the FULL box bottom face; the STL stub cylinder
  # (radius R_i) masks all cells outside the orifice-equivalent circle
  # as BLOCKED, so only the ~pi R_i^2 area actually sees inflow.  Gas-
  # only inlet (bc_ep_s(3,1)=0.0); bc_pic_mi_const_statwt is set but no
  # parcels actually enter via this BC.
    bc_type(3) = 'MI'
    bc_x_w(3)  = {{ bc_mi_x_w_m }}
    bc_x_e(3)  = {{ bc_mi_x_e_m }}
    bc_y_s(3)  = {{ bc_mi_y_s_m }}
    bc_y_n(3)  = {{ bc_mi_y_n_m }}
    bc_z_b(3)  = {{ bc_mi_z_b_m }}
    bc_z_t(3)  = {{ bc_mi_z_t_m }}
    bc_ep_g(3) = 1.0
    bc_p_g(3)  = 101325
    bc_t_g(3)  = 293.15
    bc_u_g(3)  = 0.0
    bc_v_g(3)  = {{ U_in_m_s }}
    bc_w_g(3)  = 0.0
    bc_ep_s(3,1) = 0.0
    bc_pic_mi_const_statwt(3,1) = {{ bc_pic_mi_const_statwt }}
    bc_t_s(3,1)  = 293.15
    bc_u_s(3,1)  = 0.0
    bc_v_s(3,1)  = 0.0
    bc_w_s(3,1)  = 0.0

  bc_default_walls = .True.

# Monitors (1 kHz sampling matches S1 and S2's 1000 Hz experimental sampling).
# monitor_type=4 ("arithmetic average over region (cell)") needs non-zero
# volume; plane monitors (y_s=y_n) return zero-volume cells and MFiX
# writes the undefined sentinel.  Each plane monitor is extended over one
# dy_min_m-thick slab so the volume is finite.
  # Monitor 1: inlet-plane gas pressure.  Sampled across the orifice-
  # aligned square |x|,|z| <= R_i so the probe stays near the axis
  # (the MI spans the full box bottom in Day-10 R1).
    monitor_type(1) = 4
    monitor_name(1) = 'V_3d_P_inlet'
    monitor_x_w(1)  = {{ orifice_x_w_m }}
    monitor_x_e(1)  = {{ orifice_x_e_m }}
    monitor_y_s(1)  = 0.0
    monitor_y_n(1)  = {{ dy_min_m }}
    monitor_z_b(1)  = {{ orifice_z_b_m }}
    monitor_z_t(1)  = {{ orifice_z_t_m }}
    monitor_dt(1)   = {{ monitor_dt_s }}
    monitor_p_g(1)  = .True.

  # Monitor 2: top-of-bed gas pressure.
    monitor_type(2) = 4
    monitor_name(2) = 'V_3d_P_top_bed'
    monitor_x_w(2)  = {{ x_min_m }}
    monitor_x_e(2)  = {{ x_max_m }}
    monitor_y_s(2)  = {{ H_static_m }}
    monitor_y_n(2)  = {{ "%.6e"|format(H_static_m + dy_min_m) }}
    monitor_z_b(2)  = {{ z_min_m }}
    monitor_z_t(2)  = {{ z_max_m }}
    monitor_dt(2)   = {{ monitor_dt_s }}
    monitor_p_g(2)  = .True.

  # Monitor 3: domain-integrated solids inventory (volume integral of
  # the Eulerian ep_s mean field; PIC projects parcel mass to the grid
  # via DES_INTERP_MEAN_FIELDS=.True., so MONITOR_EP_S is valid).
    monitor_type(3) = 11
    monitor_name(3) = 'V_3d_solids_inventory'
    monitor_x_w(3)  = {{ x_min_m }}
    monitor_x_e(3)  = {{ x_max_m }}
    monitor_y_s(3)  = 0.0
    monitor_y_n(3)  = {{ H_dom_m }}
    monitor_z_b(3)  = {{ z_min_m }}
    monitor_z_t(3)  = {{ z_max_m }}
    monitor_dt(3)   = {{ monitor_dt_s }}
    monitor_ep_s(3,1) = .True.

  # Monitor 4: centerline gas velocity probe at mid-bed height (y = H_mid).
  # Sampled across the orifice-aligned square |x|,|z| <= R_i to capture
  # the central spout column (the MI spans the full box bottom in R1).
    monitor_type(4) = 4
    monitor_name(4) = 'V_3d_centerline_vg'
    monitor_x_w(4)  = {{ orifice_x_w_m }}
    monitor_x_e(4)  = {{ orifice_x_e_m }}
    monitor_y_s(4)  = {{ H_mid_m }}
    monitor_y_n(4)  = {{ "%.6e"|format(H_mid_m + dy_min_m) }}
    monitor_z_b(4)  = {{ orifice_z_b_m }}
    monitor_z_t(4)  = {{ orifice_z_t_m }}
    monitor_dt(4)   = {{ monitor_dt_s }}
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: whole domain cell-centred EP_G / P_G / Gas_Velocity.  PIC
  # projects parcel mass to the Eulerian mean fields so EP_G carries the
  # 1 - ep_s information even without a Solids_Velocity cell field.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = {{ x_min_m }}
    vtk_x_e(1)      = {{ x_max_m }}
    vtk_y_s(1)      = 0.0
    vtk_y_n(1)      = {{ H_dom_m }}
    vtk_z_b(1)      = {{ z_min_m }}
    vtk_z_t(1)      = {{ z_max_m }}
    vtk_data(1)     = 'C'
    vtk_dt(1)       = {{ vtk_dt_s }}
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: parcel positions, diameter, velocity (data='P' = particles).
  # PIC parcels are tracked in continuous space; dump them as a point-
  # cloud VTP so Day 11-12 CFD-DEM comparisons can reuse the same
  # post-processor path.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = {{ x_min_m }}
    vtk_x_e(2)           = {{ x_max_m }}
    vtk_y_s(2)           = {{ y_min_m }}
    vtk_y_n(2)           = {{ H_dom_m }}
    vtk_z_b(2)           = {{ z_min_m }}
    vtk_z_t(2)           = {{ z_max_m }}
    vtk_data(2)          = 'P'
    vtk_dt(2)            = {{ vtk_dt_s }}
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only -- PIC has no solids residual to monitor).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block (shared by PIC: gas->parcel interpolation and
### initial parcel generation from the IC_PIC_CONST_STATWT fields).
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = '{{ des_interp_scheme }}'
  gener_part_config      = .True.

### Shared solids-stress knob (used by PIC through its continuum stress).
### des_epg_clip is the minimum gas volume fraction used in drag/stress
### evaluation; NETL ships 0.42 as the PIC tutorial default and Case V's
### ep_star = 0.42 happens to match it identically (physics coincidence,
### both describing the min-fluidization void fraction).
  des_epg_clip   = {{ des_epg_clip }}
  friction_model = '{{ friction_model }}'

### Particle-in-cell model (Harris-Crighton continuum closure parameters,
### from NETL tutorials/pic/spouted_bed_3d/spouted_bed_pic_3d.mfx).
  fric_exp_pic        = {{ fric_exp_pic }}
  fric_non_sing_fac   = {{ fric_non_sing_fac }}
  mppic_coeff_en1     = {{ mppic_coeff_en1 }}
  mppic_coeff_en_wall = {{ mppic_coeff_en_wall }}
  mppic_coeff_et_wall = {{ mppic_coeff_et_wall }}
  mppic_velfac_coeff  = {{ mppic_velfac_coeff }}
  psfac_fric_pic      = {{ psfac_fric_pic }}
