### Two-fluid model closure (same choices as Day-5 tutorial, except
### ep_star: unified with Case V on a physical basis -- random close
### packing of monodisperse 500 um smooth spheres eps_s,RCP ~ 0.636
### (Scott & Kilgour 1969; Gidaspow 1994 Ch. 2). Threshold
### 1 - ep_star = 0.63 is 8% above IC
### eps_s_bed = 0.55, so Schaeffer frictional stress is inactive
### at t = 0 by physics, not numerical tuning. See params/particles.yaml
### case_D.ep_star.
  c_e            = 0.95
  c_f            = 0.1
  ep_star        = 0.37
  friction_model = 'SCHAEFFER'
  kt_type        = 'ALGEBRAIC'
  phi            = 30.0
  phi_w          = 11.3
  rdf_type       = 'CARNAHAN_STARLING'
