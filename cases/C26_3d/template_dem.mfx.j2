#! Generated by src/run_C26_3d.py (Case C26 -- Conry et al. 2026,
#! Nucl. Eng. Des. 456:115009, ORNL benchtop spout-fluidized bed).
#! Case {{ case_id }}: {{ feedstock_label }}, {{ flow_slpm }} slpm Ar,
#! d_p = {{ "%.1f"|format(d_p_m * 1.0e6) }} um, rho_p = {{ "%.1f"|format(rho_p_kg_m3) }} kg/m^3, charge {{ "%g"|format(inventory_kg * 1.0e3) }} g,
#! solids_model = {{ solids_model }} (statistical weight {{ cgp_stat_wt }}, parcel {{ "%.3f"|format(d_parcel_m * 1.0e3) }} mm),
#! particle-wall friction {{ mew_w }}.
#!
#! Differs from cases/V_3d/template_dem.mfx.j2 on purpose (see
#! notes/c26_conry2026_case.md):
#!   - gas enters through ONE point-source cell on the axis (ps_*), not a
#!     mass inflow through an STL stub pipe;
#!   - the STL is a closed cone + column (no stub, flat cap at y = 0);
#!   - a single loose bed IC seeded from the measured PSD (ic_psd_*);
#!   - TGS drag, C26 Table 1 contact parameters;
#!   - a 0.6 s / 2 ms particle-VTK window at the end of the run for PIV.
#! New keywords (ps_*, ic_psd_*, vtk_t_start/vtk_t_end, drag_type='TGS')
#! were checked against the installed MFiX 26.1.2 source on 2026-10-16
#! (CLAUDE.md rule 1); the rest are reused unchanged from the verified
#! V_3d DEM template.

### Run controls
  description = '{{ description }}'
  run_name    = '{{ run_name }}'
  units       = 'SI'
  run_type    = '{{ run_type }}'
  tstop       = {{ tstop_s }}
  dt          = {{ "%.6e"|format(dt_s) }}
  # DMP (MPI) decomposition: nodesi * nodesj * nodesk = mpirun -np.
  nodesi = {{ nodes_i }}
  nodesj = {{ nodes_j }}
  nodesk = {{ nodes_k }}
  dt_min      = {{ "%.6e"|format(dt_min_s) }}
  # dt_max = min(C26 time step {{ "%.1e"|format(dt_max_paper_s) }} s, 0.5 * dx / U_nozzle (recipe
  # Rule 9)) with dx = {{ "%.4e"|format(dx_m) }} m and U_nozzle = {{ "%.4f"|format(U_nozzle_m_s) }} m/s.
  dt_max      = {{ "%.6e"|format(dt_max_s) }}
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  # Tenneti, Garg & Subramaniam (2011) drag (C26 2.2.1).
  drag_type   = '{{ drag_type }}'
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (closed cone + column STL: {{ stl_filename }}).
  cartesian_grid  = .True.
  use_stl         = .True.
  stl_small_angle = 0.0
  out_stl_value   = 1.0

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = {{ max_nit }}
  norm_g       = 0.0

### Geometry (cartesian 3D, uniform dx = D_c / 24; odd cell count across
### the box so the vessel axis is a cell centre)
  coordinates = 'CARTESIAN'
  imax        = {{ imax }}
  jmax        = {{ jmax }}
  kmax        = {{ kmax }}
  x_min       = {{ "%.6e"|format(x_min_m) }}
  x_max       = {{ "%.6e"|format(x_max_m) }}
  y_min       = {{ "%.6e"|format(y_min_m) }}
  y_max       = {{ "%.6e"|format(H_dom_m) }}
  z_min       = {{ "%.6e"|format(z_min_m) }}
  z_max       = {{ "%.6e"|format(z_max_m) }}
{%- for d in dx_m_list %}
  dx({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dy_m_list %}
  dy({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}
{%- for d in dz_m_list %}
  dz({{ loop.index0 }}) = {{ "%.6e"|format(d) }}
{%- endfor %}

#### Fluid ({{ gas_case }}: {{ T_g_K }} K, {{ p_g_Pa }} Pa)
  mu_g0      = {{ "%.6e"|format(mu_g_pa_s) }}
  mu_g_model = 'CONSTANT'
  ro_g0      = {{ "%.6e"|format(rho_g_kg_m3) }}

#### Solids (CFD-DEM soft-sphere spring-dashpot)
  mmax = 1
  # d_p0 / ro_s0 are REAL particle values; in CGP mode MFiX scales the
  # parcel size by cgp_stat_wt^(1/3) internally, including the IC PSD.
    solids_model(1) = '{{ solids_model }}'
    d_p0(1)         = {{ "%.6e"|format(d_p_m) }}
    ro_s0(1)        = {{ rho_p_kg_m3 }}
    nmax_s(1)       = 0
{%- if solids_model == 'CGP' %}
    cgp_stat_wt(1)  = {{ cgp_stat_wt }}
{%- endif %}

### Initial conditions
  # IC 1: whole box, gas only (recipe Rule 7).
    ic_x_w(1)    = {{ "%.6e"|format(x_min_m) }}
    ic_x_e(1)    = {{ "%.6e"|format(x_max_m) }}
    ic_y_s(1)    = {{ "%.6e"|format(y_min_m) }}
    ic_y_n(1)    = {{ "%.6e"|format(H_dom_m) }}
    ic_z_b(1)    = {{ "%.6e"|format(z_min_m) }}
    ic_z_t(1)    = {{ "%.6e"|format(z_max_m) }}
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = {{ T_g_K }}
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = {{ p_g_Pa }}
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = {{ T_g_K }}
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: loose bed over the full cross-section, 0 <= y <= H_ic =
  # {{ "%.4f"|format(H_ic_m) }} m, eps_s = {{ eps_s_ic }}.  Lattice sites outside
  # the cone are dropped by the cut-cell geometry.  Inventory-conserving:
  # {{ "%.1f"|format(inventory_kg * 1000) }} g (C26 2.2.2).  The bed settles under gravity.
    ic_x_w(2)    = {{ "%.6e"|format(x_min_m) }}
    ic_x_e(2)    = {{ "%.6e"|format(x_max_m) }}
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = {{ "%.6e"|format(H_ic_m) }}
    ic_z_b(2)    = {{ "%.6e"|format(z_min_m) }}
    ic_z_t(2)    = {{ "%.6e"|format(z_max_m) }}
    ic_ep_g(2)   = {{ ep_g_ic }}
    ic_t_g(2)    = {{ T_g_K }}
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = {{ eps_s_ic }}
    ic_t_s(2,1)  = {{ T_g_K }}
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0
    ic_des_lattice(2,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(2,1) = .False.
    ic_des_tight_boundary_spacing(2,1) = .True.
    ic_des_spacing(2,1) = 0.05
    # Measured PSD (C26 2.2.2, Fig. 2): mean, sigma = sqrt(variance),
    # truncated at mean +/- 3 sigma.  REAL particle sizes.
    ic_psd_type(2,1)    = '{{ psd_type }}'
    ic_psd_mean_dp(2,1) = {{ "%.6e"|format(psd_mean_dp_m) }}
    ic_psd_stdev(2,1)   = {{ "%.6e"|format(psd_stdev_m) }}
    ic_psd_min_dp(2,1)  = {{ "%.6e"|format(psd_min_dp_m) }}
    ic_psd_max_dp(2,1)  = {{ "%.6e"|format(psd_max_dp_m) }}

# Boundary conditions
  # BC 1: cut-cell (STL) no-slip wall.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: pressure outflow at the top (y = H_dom = {{ "%.4f"|format(H_dom_m) }} m).
    bc_type(2) = 'PO'
    bc_x_w(2)  = {{ "%.6e"|format(x_min_m) }}
    bc_x_e(2)  = {{ "%.6e"|format(x_max_m) }}
    bc_y_s(2)  = {{ "%.6e"|format(H_dom_m) }}
    bc_y_n(2)  = {{ "%.6e"|format(H_dom_m) }}
    bc_z_b(2)  = {{ "%.6e"|format(z_min_m) }}
    bc_z_t(2)  = {{ "%.6e"|format(z_max_m) }}
    bc_p_g(2)  = {{ p_g_Pa }}

  bc_default_walls = .True.

# Point source (C26 2.2.1): one cell centred on the axis at the bottom of
# the cone.  MFiX 26.1.2 adds ps_massflow_g over the fluid volume of the
# cell and momentum ps_massflow_g * |v| * v_hat (source_v_g.f).
{%- if ps_momentum %}
# ps_v_g is the nozzle exit velocity Q / (pi D_n^2 / 4).
{%- else %}
# MASS-ONLY source: ps_v_g = 0, so no momentum is added (source_v_g.f skips
# |v| < small_number) and continuity accelerates the gas out of the cell.
{%- endif %}
#   flow = {{ flow_slpm }} slpm Ar -> m_dot = {{ "%.6e"|format(ps_massflow_g_kg_s) }} kg/s,
#   U_nozzle = {{ "%.4f"|format(U_nozzle_m_s) }} m/s (D_n = {{ "%.5e"|format(2 * R_nozzle_m) }} m).
# The region is the axis cell's faces, not a zero-width point: get_ps.f /
# calc_cell.f round a point at a cell centre to a face, which put the c01
# smoke's source in a corner sliver cut cell (run_log 2026-10-16).
    ps_x_w(1)        = {{ "%.6e"|format(ps_cell_x_w_m) }}
    ps_x_e(1)        = {{ "%.6e"|format(ps_cell_x_e_m) }}
    ps_y_s(1)        = {{ "%.6e"|format(ps_cell_y_s_m) }}
    ps_y_n(1)        = {{ "%.6e"|format(ps_cell_y_n_m) }}
    ps_z_b(1)        = {{ "%.6e"|format(ps_cell_z_b_m) }}
    ps_z_t(1)        = {{ "%.6e"|format(ps_cell_z_t_m) }}
    ps_massflow_g(1) = {{ "%.6e"|format(ps_massflow_g_kg_s) }}
    ps_u_g(1)        = 0.0
    ps_v_g(1)        = {{ "%.6e"|format(ps_v_g_m_s) }}
    ps_w_g(1)        = 0.0

# Monitors (1 kHz).
  # Monitor 1: gas pressure in the point-source cell (inlet pressure).
    monitor_type(1) = 4
    monitor_name(1) = '{{ run_name }}_P_inlet'
    monitor_x_w(1)  = {{ "%.6e"|format(ps_cell_x_w_m) }}
    monitor_x_e(1)  = {{ "%.6e"|format(ps_cell_x_e_m) }}
    monitor_y_s(1)  = {{ "%.6e"|format(ps_cell_y_s_m) }}
    monitor_y_n(1)  = {{ "%.6e"|format(ps_cell_y_n_m) }}
    monitor_z_b(1)  = {{ "%.6e"|format(ps_cell_z_b_m) }}
    monitor_z_t(1)  = {{ "%.6e"|format(ps_cell_z_t_m) }}
    monitor_dt(1)   = {{ monitor_dt_s }}
    monitor_p_g(1)  = .True.

  # Monitor 2: gas pressure at the packed static-bed height.
    monitor_type(2) = 4
    monitor_name(2) = '{{ run_name }}_P_top_bed'
    monitor_x_w(2)  = {{ "%.6e"|format(x_min_m) }}
    monitor_x_e(2)  = {{ "%.6e"|format(x_max_m) }}
    monitor_y_s(2)  = {{ "%.6e"|format(H_static_m) }}
    monitor_y_n(2)  = {{ "%.6e"|format(H_static_m + dx_m) }}
    monitor_z_b(2)  = {{ "%.6e"|format(z_min_m) }}
    monitor_z_t(2)  = {{ "%.6e"|format(z_max_m) }}
    monitor_dt(2)   = {{ monitor_dt_s }}
    monitor_p_g(2)  = .True.

  # Monitor 3: particle mass and count summed over the domain (inventory
  # check).  A type-11 monitor_ep_s monitor is dropped for DEM (Warning
  # 4455); type 101 + monitor_pmass follows tutorials/dem/hopper_3d.
    monitor_type(3)   = 101
    monitor_name(3)   = '{{ run_name }}_solids_inventory'
    monitor_x_w(3)    = {{ "%.6e"|format(x_min_m) }}
    monitor_x_e(3)    = {{ "%.6e"|format(x_max_m) }}
    monitor_y_s(3)    = {{ "%.6e"|format(y_min_m) }}
    monitor_y_n(3)    = {{ "%.6e"|format(H_dom_m) }}
    monitor_z_b(3)    = {{ "%.6e"|format(z_min_m) }}
    monitor_z_t(3)    = {{ "%.6e"|format(z_max_m) }}
    monitor_dt(3)     = {{ monitor_dt_s }}
    monitor_pmass(3)  = .True.
    monitor_pcount(3) = .True.

  # Monitor 4: centerline gas velocity at mid static-bed height.
    monitor_type(4) = 4
    monitor_name(4) = '{{ run_name }}_centerline_vg'
    monitor_x_w(4)  = {{ "%.6e"|format(ps_cell_x_w_m) }}
    monitor_x_e(4)  = {{ "%.6e"|format(ps_cell_x_e_m) }}
    monitor_y_s(4)  = {{ "%.6e"|format(H_mid_m) }}
    monitor_y_n(4)  = {{ "%.6e"|format(H_mid_m + dx_m) }}
    monitor_z_b(4)  = {{ "%.6e"|format(ps_cell_z_b_m) }}
    monitor_z_t(4)  = {{ "%.6e"|format(ps_cell_z_t_m) }}
    monitor_dt(4)   = {{ monitor_dt_s }}
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: cell-centred EP_G / P_G / gas velocity over the whole run.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = {{ "%.6e"|format(x_min_m) }}
    vtk_x_e(1)      = {{ "%.6e"|format(x_max_m) }}
    vtk_y_s(1)      = {{ "%.6e"|format(y_min_m) }}
    vtk_y_n(1)      = {{ "%.6e"|format(H_dom_m) }}
    vtk_z_b(1)      = {{ "%.6e"|format(z_min_m) }}
    vtk_z_t(1)      = {{ "%.6e"|format(z_max_m) }}
    vtk_data(1)     = 'C'
    vtk_dt(1)       = {{ vtk_dt_background_s }}
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: particles (position, diameter, velocity, id) over the whole run.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = {{ "%.6e"|format(x_min_m) }}
    vtk_x_e(2)           = {{ "%.6e"|format(x_max_m) }}
    vtk_y_s(2)           = {{ "%.6e"|format(y_min_m) }}
    vtk_y_n(2)           = {{ "%.6e"|format(H_dom_m) }}
    vtk_z_b(2)           = {{ "%.6e"|format(z_min_m) }}
    vtk_z_t(2)           = {{ "%.6e"|format(z_max_m) }}
    vtk_data(2)          = 'P'
    vtk_dt(2)            = {{ vtk_dt_particles_s }}
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.
    vtk_part_id(2)       = .True.

  # VTK 3: PIV window -- particles every {{ piv_frame_dt_s }} s for {{ piv_n_frames }} frames,
  # t in [{{ "%.4f"|format(piv_t_start_s) }}, {{ "%.4f"|format(piv_t_end_s) }}] s (C26 2.2.2).  Input to the
  # synthetic side-view PIV comparison against C26 Fig. 4 / Table 3.
    vtk_filebase(3)      = 'Particles_PIV'
    vtk_x_w(3)           = {{ "%.6e"|format(x_min_m) }}
    vtk_x_e(3)           = {{ "%.6e"|format(x_max_m) }}
    vtk_y_s(3)           = {{ "%.6e"|format(y_min_m) }}
    vtk_y_n(3)           = {{ "%.6e"|format(H_dom_m) }}
    vtk_z_b(3)           = {{ "%.6e"|format(z_min_m) }}
    vtk_z_t(3)           = {{ "%.6e"|format(z_max_m) }}
    vtk_data(3)          = 'P'
    vtk_dt(3)            = {{ piv_frame_dt_s }}
    vtk_t_start(3)       = {{ "%.6e"|format(piv_t_start_s) }}
    vtk_t_end(3)         = {{ "%.6e"|format(piv_t_end_s) }}
    vtk_nxs(3)           = 0
    vtk_nys(3)           = 0
    vtk_nzs(3)           = 0
    vtk_part_diameter(3) = .True.
    vtk_part_vel(3)      = .True.
    vtk_part_id(3)       = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block.
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = '{{ des_interp_scheme }}'
{%- if des_interp_width_m is not none %}
  des_interp_width       = {{ "%.6e"|format(des_interp_width_m) }}
{%- endif %}
  gener_part_config      = .True.
  des_oneway_coupled     = .False.
  des_epg_clip           = {{ des_epg_clip }}

### DEM contact block (C26 Table 1; particle-wall friction per C26 Table 2).
  kn                   = {{ kn }}
  kn_w                 = {{ kn_w }}
  kt_fac               = {{ kt_fac }}
  kt_w_fac             = {{ kt_w_fac }}
  mew                  = {{ mew }}
  mew_w                = {{ mew_w }}
  des_en_input(1)      = {{ des_en_input_pp }}
  des_en_wall_input(1) = {{ des_en_input_pw }}
  des_etat_fac         = {{ des_etat_fac }}
  des_etat_w_fac       = {{ des_etat_w_fac }}
