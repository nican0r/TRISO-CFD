#! Generated by src/run_C26_3d.py (Case C26 -- Conry et al. 2026,
#! Nucl. Eng. Des. 456:115009, ORNL benchtop spout-fluidized bed).
#! Case c02: YSZ 400 um nominal (TOSOH), 12.0 slpm Ar,
#! d_p = 411.6 um, rho_p = 6000.0 kg/m^3, charge 60 g,
#! solids_model = CGP (statistical weight 10.0, parcel 0.887 mm),
#! particle-wall friction 0.1.
#!
#! Differs from cases/V_3d/template_dem.mfx.j2 on purpose (see
#! notes/c26_conry2026_case.md):
#!   - gas enters through ONE point-source cell on the axis (ps_*), not a
#!     mass inflow through an STL stub pipe;
#!   - the STL is a closed cone + column (no stub, flat cap at y = 0);
#!   - a single bed IC region seeded from the measured PSD (ic_psd_*);
#!   - TGS drag, C26 Table 1 contact parameters;
#!   - a 0.6 s / 2 ms particle-VTK window at the end of the run for PIV.
#! New keywords (ps_*, ic_psd_*, vtk_t_start/vtk_t_end, drag_type='TGS'
#! 2026-10-16; monitor_pmass/monitor_pcount 2026-10-17; des_interp_width,
#! SQUARE_DPVM only, 2026-10-19) were checked against the installed MFiX
#! 26.1.2 source (CLAUDE.md rule 1; notes/c26_conry2026_case.md "Keyword
#! verification"); the rest are reused unchanged from the verified V_3d DEM
#! template.
#! MFiX 23.2 deck: every keyword checked against the 23.2 source
#! namelists (2026-10-24, notes/c26_conry2026_case.md "MFiX 23.2 decks and
#! AWS image").
#! The four 26.1.2-only keywords (mu_g_model, ic_des_abort_on_failed_seeding,
#! ic_des_tight_boundary_spacing, bc_default_walls) are left out; a comment
#! stands where each would be.

### Run controls
  description = 'C26 c02: case_C26_ysz (bare), 60 g, 12 slpm Ar (Conry et al. 2026 model)'
  run_name    = 'C26_c02_point_mom_v232'
  units       = 'SI'
  run_type    = 'new'
  tstop       = 3.0
  dt          = 1.000000e-05
  # DMP (MPI) decomposition: nodesi * nodesj * nodesk = mpirun -np.
  nodesi = 2
  nodesj = 1
  nodesk = 2
  dt_min      = 1.000000e-07
  # dt_max = min(C26 time step 1.0e-05 s, 0.5 * dx / U_nozzle (recipe
  # Rule 9)) with dx = 2.1000e-03 m and U_nozzle = 44.9087 m/s.
  dt_max      = 1.000000e-05
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  # Tenneti, Garg & Subramaniam (2011) drag (C26 2.2.1).
  drag_type   = 'TGS'
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (closed cone + column STL: geometry_0001.stl).
  cartesian_grid  = .True.
  use_stl         = .True.
  stl_small_angle = 0.0
  out_stl_value   = 1.0

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = 50
  norm_g       = 0.0

