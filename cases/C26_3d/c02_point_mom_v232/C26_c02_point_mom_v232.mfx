#### Fluid (ar_25C: 298.15 K, 101325.0 Pa)
  mu_g0      = 2.302324e-05
  # MFiX 23.2 has no mu_g_model: a defined mu_g0 is a constant
  # viscosity (set_constprop.f).
  ro_g0      = 1.632918e+00

#### Solids (CFD-DEM soft-sphere spring-dashpot)
  mmax = 1
  # d_p0 / ro_s0 are REAL particle values; in CGP mode MFiX scales the
  # parcel size by cgp_stat_wt^(1/3) internally, including the IC PSD.
    solids_model(1) = 'CGP'
    d_p0(1)         = 4.116000e-04
    ro_s0(1)        = 6000.0
    nmax_s(1)       = 0
    cgp_stat_wt(1)  = 10.0

### Initial conditions
  # IC 1: whole box, gas only (recipe Rule 7).
    ic_x_w(1)    = -2.520000e-02
    ic_x_e(1)    = 2.520000e-02
    ic_y_s(1)    = -8.400000e-03
    ic_y_n(1)    = 2.100000e-01
    ic_z_b(1)    = -2.520000e-02
    ic_z_t(1)    = 2.520000e-02
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 298.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = 298.15
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: bed region over the full cross-section, 0 <= y <= H_ic =
  # 0.0437 m.  ic_ep_s = 0.3 sets the parcel count only, sized for
  # 60.0 g (params/sweep_C26.yaml; C26 2.2.2: 60 g).  MFiX packs the
  # parcels on the HEXA lattice from y = 0 up, so the bed starts denser than
  # eps_s and below H_ic.  Lattice sites outside the cone are dropped by the
  # cut-cell geometry.  The bed settles under gravity.
    ic_x_w(2)    = -2.520000e-02
    ic_x_e(2)    = 2.520000e-02
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = 4.374589e-02
    ic_z_b(2)    = -2.520000e-02
    ic_z_t(2)    = 2.520000e-02
    ic_ep_g(2)   = 0.7
    ic_t_g(2)    = 298.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = 0.3
    ic_t_s(2,1)  = 298.15
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0
    ic_des_lattice(2,1) = 'HEXA'
    # MFiX 23.2 has neither seeding flag (generate_particles_mod.f):
    # a short parcel count is only a warning (= abort_on_failed_seeding
    # .False.), and the lattice keeps a one-radius margin inside the IC box
    # (= tight_boundary_spacing .False., unlike the 26.1.2 decks).
    ic_des_spacing(2,1) = 0.05
    # Measured feedstock PSD (C26 2.2.2, Fig. 2), mean shifted by any TRISO
    # layers: sigma = sqrt(variance), truncated at mean +/- psd_n_sigma sigma
    # (params/particles.yaml).  REAL particle sizes.
    ic_psd_type(2,1)    = 'NORMAL'
    ic_psd_mean_dp(2,1) = 4.116000e-04
    ic_psd_stdev(2,1)   = 1.221065e-05
    ic_psd_min_dp(2,1)  = 3.749680e-04
    ic_psd_max_dp(2,1)  = 4.482320e-04

# Boundary conditions
  # BC 1: cut-cell (STL) no-slip wall.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: pressure outflow at the top (y = H_dom = 0.2100 m).
    bc_type(2) = 'PO'
    bc_x_w(2)  = -2.520000e-02
    bc_x_e(2)  = 2.520000e-02
    bc_y_s(2)  = 2.100000e-01
    bc_y_n(2)  = 2.100000e-01
    bc_z_b(2)  = -2.520000e-02
    bc_z_t(2)  = 2.520000e-02
    bc_p_g(2)  = 101325.0

  # MFiX 23.2 has no bc_default_walls: it always applies default
  # walls along the MFiX box (set_icbc_flags.f; = bc_default_walls .True.).

# Point source (C26 2.2.1): one cell centred on the axis at the bottom of
# the cone.  MFiX 26.1.2 adds ps_massflow_g over the fluid volume of the
# cell and momentum ps_massflow_g * |v| * v_hat (source_v_g.f).
# ps_v_g is the nozzle exit velocity Q / (pi D_n^2 / 4).
# CLOSED-APEX STL (src/make_stl_c26_apex.py): the cone continues to its apex
# at y = -2.0622e-03 m and the source fills the tip row y in [-dx, 0]; the open
# area at y = 0 is pi R_t^2 = 4.453e-06 m^2, so by continuity the gas leaves
# the tip at U_nozzle.
#   flow = 12.0 slpm Ar -> m_dot = 3.265836e-04 kg/s,
#   U_nozzle = 44.9087 m/s (D_n = 2.38125e-03 m).
# POINT region (C26 p.4, "a point source centered with the reactor"): on the
# axis-on-face grid get_ps.f / calc_cell.f snap this point to ONE cell, the
# -x / -z cell x, z in [-2.1000e-03, 0.0000e+00] m of the source row, not the 2 x 2
# axis cells; y sits a quarter cell below the row's north face so it maps to
# that row (dry run ps_point_dry, run_log 2026-10-24).
    ps_x_w(1)        = 0.000000e+00
    ps_x_e(1)        = 0.000000e+00
    ps_y_s(1)        = -5.250000e-04
    ps_y_n(1)        = -5.250000e-04
    ps_z_b(1)        = 0.000000e+00
    ps_z_t(1)        = 0.000000e+00
    ps_massflow_g(1) = 3.265836e-04
    ps_u_g(1)        = 0.0
    ps_v_g(1)        = 4.490866e+01
    ps_w_g(1)        = 0.0

# Monitors (1 kHz).
  # Monitor 1: gas pressure in the point-source cell (inlet pressure).
    monitor_type(1) = 4
    monitor_name(1) = 'C26_c02_point_mom_v232_P_inlet'
    monitor_x_w(1)  = -2.100000e-03
    monitor_x_e(1)  = 0.000000e+00
    monitor_y_s(1)  = -2.100000e-03
    monitor_y_n(1)  = 0.000000e+00
    monitor_z_b(1)  = -2.100000e-03
    monitor_z_t(1)  = 0.000000e+00
    monitor_dt(1)   = 0.001
    monitor_p_g(1)  = .True.

  # Monitor 2: gas pressure at the packed static-bed height.
    monitor_type(2) = 4
    monitor_name(2) = 'C26_c02_point_mom_v232_P_top_bed'
    monitor_x_w(2)  = -2.520000e-02
    monitor_x_e(2)  = 2.520000e-02
    monitor_y_s(2)  = 3.484385e-02
    monitor_y_n(2)  = 3.694385e-02
    monitor_z_b(2)  = -2.520000e-02
    monitor_z_t(2)  = 2.520000e-02
    monitor_dt(2)   = 0.001
    monitor_p_g(2)  = .True.

  # Monitor 3: particle mass and count summed over the domain (inventory
  # check).  A type-11 monitor_ep_s monitor is dropped for DEM (Warning
  # 4455); type 101 + monitor_pmass follows tutorials/dem/hopper_3d.
    monitor_type(3)   = 101
    monitor_name(3)   = 'C26_c02_point_mom_v232_solids_inventory'
    monitor_x_w(3)    = -2.520000e-02
    monitor_x_e(3)    = 2.520000e-02
    monitor_y_s(3)    = -8.400000e-03
    monitor_y_n(3)    = 2.100000e-01
    monitor_z_b(3)    = -2.520000e-02
    monitor_z_t(3)    = 2.520000e-02
    monitor_dt(3)     = 0.001
    monitor_pmass(3)  = .True.
    monitor_pcount(3) = .True.

  # Monitor 4: centerline gas velocity at mid static-bed height.
    monitor_type(4) = 4
    monitor_name(4) = 'C26_c02_point_mom_v232_centerline_vg'
    monitor_x_w(4)  = -2.100000e-03
    monitor_x_e(4)  = 0.000000e+00
    monitor_y_s(4)  = 1.742193e-02
    monitor_y_n(4)  = 1.952193e-02
    monitor_z_b(4)  = -2.100000e-03
    monitor_z_t(4)  = 0.000000e+00
    monitor_dt(4)   = 0.001
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: cell-centred EP_G / P_G / gas velocity over the whole run.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = -2.520000e-02
    vtk_x_e(1)      = 2.520000e-02
    vtk_y_s(1)      = -8.400000e-03
    vtk_y_n(1)      = 2.100000e-01
    vtk_z_b(1)      = -2.520000e-02
    vtk_z_t(1)      = 2.520000e-02
    vtk_data(1)     = 'C'
    vtk_dt(1)       = 0.05
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: particles (position, diameter, velocity, id) over the whole run.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = -2.520000e-02
    vtk_x_e(2)           = 2.520000e-02
    vtk_y_s(2)           = -8.400000e-03
    vtk_y_n(2)           = 2.100000e-01
    vtk_z_b(2)           = -2.520000e-02
    vtk_z_t(2)           = 2.520000e-02
    vtk_data(2)          = 'P'
    vtk_dt(2)            = 0.05
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.
    vtk_part_id(2)       = .True.

  # VTK 3: PIV window -- particles every 0.002 s for 300 frames,
  # t in [2.4000, 3.0000] s (C26 2.2.2).  Input to the
  # synthetic side-view PIV comparison against C26 Fig. 4 / Table 3.
    vtk_filebase(3)      = 'Particles_PIV'
    vtk_x_w(3)           = -2.520000e-02
    vtk_x_e(3)           = 2.520000e-02
    vtk_y_s(3)           = -8.400000e-03
    vtk_y_n(3)           = 2.100000e-01
    vtk_z_b(3)           = -2.520000e-02
    vtk_z_t(3)           = 2.520000e-02
    vtk_data(3)          = 'P'
    vtk_dt(3)            = 0.002
    vtk_t_start(3)       = 2.400000e+00
    vtk_t_end(3)         = 3.000000e+00
    vtk_nxs(3)           = 0
    vtk_nys(3)           = 0
    vtk_nzs(3)           = 0
    vtk_part_diameter(3) = .True.
    vtk_part_vel(3)      = .True.
    vtk_part_id(3)       = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block.
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = 'LINEAR_HAT'
  gener_part_config      = .True.
  des_oneway_coupled     = .False.
  des_epg_clip           = 0.42

### DEM contact block (C26 Table 1; mew_w fixed at the Table 1 baseline).
  kn                   = 1000.0
  kn_w                 = 1000.0
  kt_fac               = 0.285
  kt_w_fac             = 0.285
  mew                  = 0.1
  mew_w                = 0.1
  des_en_input(1)      = 0.5
  des_en_wall_input(1) = 0.5
  des_etat_fac         = 0.5
  des_etat_w_fac       = 0.5
