#### Fluid (ar_25C: 298.15 K, 101325.0 Pa)
  mu_g0      = 2.302324e-05
  mu_g_model = 'CONSTANT'
  ro_g0      = 1.632918e+00

#### Solids (CFD-DEM soft-sphere spring-dashpot)
  mmax = 1
  # d_p0 / ro_s0 are REAL particle values; in CGP mode MFiX scales the
  # parcel size by cgp_stat_wt^(1/3) internally, including the IC PSD.
    solids_model(1) = 'CGP'
    d_p0(1)         = 4.116000e-04
    ro_s0(1)        = 6000.0
    nmax_s(1)       = 0
    cgp_stat_wt(1)  = 10.0

### Initial conditions
  # IC 1: whole box, gas only (recipe Rule 7).
    ic_x_w(1)    = -2.835000e-02
    ic_x_e(1)    = 2.835000e-02
    ic_y_s(1)    = -8.400000e-03
    ic_y_n(1)    = 2.100000e-01
    ic_z_b(1)    = -2.835000e-02
    ic_z_t(1)    = 2.835000e-02
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 298.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = 298.15
    ic_theta_m(1,1) = 0.0
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: loose bed over the full cross-section, 0 <= y <= H_ic =
  # 0.0379 m, eps_s = 0.3.  Lattice sites outside
  # the cone are dropped by the cut-cell geometry.  Inventory-conserving:
  # 40.0 g (C26 2.2.2).  The bed settles under gravity.
    ic_x_w(2)    = -2.835000e-02
    ic_x_e(2)    = 2.835000e-02
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = 3.786906e-02
    ic_z_b(2)    = -2.835000e-02
    ic_z_t(2)    = 2.835000e-02
    ic_ep_g(2)   = 0.7
    ic_t_g(2)    = 298.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_ep_s(2,1) = 0.3
    ic_t_s(2,1)  = 298.15
    ic_theta_m(2,1) = 0.0
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0
    ic_des_lattice(2,1) = 'HEXA'
    ic_des_abort_on_failed_seeding(2,1) = .False.
    ic_des_tight_boundary_spacing(2,1) = .True.
    ic_des_spacing(2,1) = 0.05
    # Measured PSD (C26 2.2.2, Fig. 2): mean, sigma = sqrt(variance),
    # truncated at mean +/- 3 sigma.  REAL particle sizes.
    ic_psd_type(2,1)    = 'NORMAL'
    ic_psd_mean_dp(2,1) = 4.116000e-04
    ic_psd_stdev(2,1)   = 1.221065e-05
    ic_psd_min_dp(2,1)  = 3.749680e-04
    ic_psd_max_dp(2,1)  = 4.482320e-04

# Boundary conditions
  # BC 1: cut-cell (STL) no-slip wall.
    bc_type(1)  = 'CG_NSW'
    bc_jj_ps(1) = 0
    bc_uw_g(1)  = 0.0
    bc_vw_g(1)  = 0.0
    bc_ww_g(1)  = 0.0

  # BC 2: pressure outflow at the top (y = H_dom = 0.2100 m).
    bc_type(2) = 'PO'
    bc_x_w(2)  = -2.835000e-02
    bc_x_e(2)  = 2.835000e-02
    bc_y_s(2)  = 2.100000e-01
    bc_y_n(2)  = 2.100000e-01
    bc_z_b(2)  = -2.835000e-02
    bc_z_t(2)  = 2.835000e-02
    bc_p_g(2)  = 101325.0

  bc_default_walls = .True.

# Point source (C26 2.2.1): one cell centred on the axis at the bottom of
# the cone.  MFiX 26.1.2 adds ps_massflow_g over the fluid volume of the
# cell and momentum ps_massflow_g * |v| * v_hat (source_v_g.f).
# MASS-ONLY source: ps_v_g = 0, so no momentum is added (source_v_g.f skips
# |v| < small_number) and continuity accelerates the gas out of the cell.
#   flow = 12.0 slpm Ar -> m_dot = 3.265836e-04 kg/s,
#   U_nozzle = 44.9087 m/s (D_n = 2.38125e-03 m).
# The region is the axis cell's faces, not a zero-width point: get_ps.f /
# calc_cell.f round a point at a cell centre to a face, which put the c01
# smoke's source in a corner sliver cut cell (run_log 2026-10-16).
    ps_x_w(1)        = -1.050000e-03
    ps_x_e(1)        = 1.050000e-03
    ps_y_s(1)        = 0.000000e+00
    ps_y_n(1)        = 2.100000e-03
    ps_z_b(1)        = -1.050000e-03
    ps_z_t(1)        = 1.050000e-03
    ps_massflow_g(1) = 3.265836e-04
    ps_u_g(1)        = 0.0
    ps_v_g(1)        = 0.000000e+00
    ps_w_g(1)        = 0.0

# Monitors (1 kHz).
  # Monitor 1: gas pressure in the point-source cell (inlet pressure).
    monitor_type(1) = 4
    monitor_name(1) = 'C26_c08_massonly_P_inlet'
    monitor_x_w(1)  = -1.050000e-03
    monitor_x_e(1)  = 1.050000e-03
    monitor_y_s(1)  = 0.000000e+00
    monitor_y_n(1)  = 2.100000e-03
    monitor_z_b(1)  = -1.050000e-03
    monitor_z_t(1)  = 1.050000e-03
    monitor_dt(1)   = 0.001
    monitor_p_g(1)  = .True.

  # Monitor 2: gas pressure at the packed static-bed height.
    monitor_type(2) = 4
    monitor_name(2) = 'C26_c08_massonly_P_top_bed'
    monitor_x_w(2)  = -2.835000e-02
    monitor_x_e(2)  = 2.835000e-02
    monitor_y_s(2)  = 3.017914e-02
    monitor_y_n(2)  = 3.227914e-02
    monitor_z_b(2)  = -2.835000e-02
    monitor_z_t(2)  = 2.835000e-02
    monitor_dt(2)   = 0.001
    monitor_p_g(2)  = .True.

  # Monitor 3: particle mass and count summed over the domain (inventory
  # check).  A type-11 monitor_ep_s monitor is dropped for DEM (Warning
  # 4455); type 101 + monitor_pmass follows tutorials/dem/hopper_3d.
    monitor_type(3)   = 101
    monitor_name(3)   = 'C26_c08_massonly_solids_inventory'
    monitor_x_w(3)    = -2.835000e-02
    monitor_x_e(3)    = 2.835000e-02
    monitor_y_s(3)    = -8.400000e-03
    monitor_y_n(3)    = 2.100000e-01
    monitor_z_b(3)    = -2.835000e-02
    monitor_z_t(3)    = 2.835000e-02
    monitor_dt(3)     = 0.001
    monitor_pmass(3)  = .True.
    monitor_pcount(3) = .True.

  # Monitor 4: centerline gas velocity at mid static-bed height.
    monitor_type(4) = 4
    monitor_name(4) = 'C26_c08_massonly_centerline_vg'
    monitor_x_w(4)  = -1.050000e-03
    monitor_x_e(4)  = 1.050000e-03
    monitor_y_s(4)  = 1.508957e-02
    monitor_y_n(4)  = 1.718957e-02
    monitor_z_b(4)  = -1.050000e-03
    monitor_z_t(4)  = 1.050000e-03
    monitor_dt(4)   = 0.001
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: cell-centred EP_G / P_G / gas velocity over the whole run.
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = -2.835000e-02
    vtk_x_e(1)      = 2.835000e-02
    vtk_y_s(1)      = -8.400000e-03
    vtk_y_n(1)      = 2.100000e-01
    vtk_z_b(1)      = -2.835000e-02
    vtk_z_t(1)      = 2.835000e-02
    vtk_data(1)     = 'C'
    vtk_dt(1)       = 0.05
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.

  # VTK 2: particles (position, diameter, velocity, id) over the whole run.
    vtk_filebase(2)      = 'Particles'
    vtk_x_w(2)           = -2.835000e-02
    vtk_x_e(2)           = 2.835000e-02
    vtk_y_s(2)           = -8.400000e-03
    vtk_y_n(2)           = 2.100000e-01
    vtk_z_b(2)           = -2.835000e-02
    vtk_z_t(2)           = 2.835000e-02
    vtk_data(2)          = 'P'
    vtk_dt(2)            = 0.05
    vtk_nxs(2)           = 0
    vtk_nys(2)           = 0
    vtk_nzs(2)           = 0
    vtk_part_diameter(2) = .True.
    vtk_part_vel(2)      = .True.
    vtk_part_id(2)       = .True.

  # VTK 3: PIV window -- particles every 0.002 s for 300 frames,
  # t in [2.4000, 3.0000] s (C26 2.2.2).  Input to the
  # synthetic side-view PIV comparison against C26 Fig. 4 / Table 3.
    vtk_filebase(3)      = 'Particles_PIV'
    vtk_x_w(3)           = -2.835000e-02
    vtk_x_e(3)           = 2.835000e-02
    vtk_y_s(3)           = -8.400000e-03
    vtk_y_n(3)           = 2.100000e-01
    vtk_z_b(3)           = -2.835000e-02
    vtk_z_t(3)           = 2.835000e-02
    vtk_data(3)          = 'P'
    vtk_dt(3)            = 0.002
    vtk_t_start(3)       = 2.400000e+00
    vtk_t_end(3)         = 3.000000e+00
    vtk_nxs(3)           = 0
    vtk_nys(3)           = 0
    vtk_nzs(3)           = 0
    vtk_part_diameter(3) = .True.
    vtk_part_vel(3)      = .True.
    vtk_part_id(3)       = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals (gas phase only).
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'

### Discrete-element block.
  des_interp_mean_fields = .True.
  des_interp_on          = .True.
  des_interp_scheme      = 'LINEAR_HAT'
  gener_part_config      = .True.
  des_oneway_coupled     = .False.
  des_epg_clip           = 0.42

### DEM contact block (C26 Table 1; particle-wall friction per C26 Table 2).
  kn                   = 1000.0
  kn_w                 = 1000.0
  kt_fac               = 0.285
  kt_w_fac             = 0.285
  mew                  = 0.1
  mew_w                = 0.1
  des_en_input(1)      = 0.5
  des_en_wall_input(1) = 0.5
  des_etat_fac         = 0.5
  des_etat_w_fac       = 0.5
