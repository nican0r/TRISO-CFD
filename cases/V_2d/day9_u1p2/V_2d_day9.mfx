#! Generated by src/make_case.py (Day 8 rev 4 - Case V 2D quadric spouted bed)
#! Coordinates: cartesian, cartesian_grid=.True., no_k=.True.,
#!              use_stl=.False., n_quadric=1 (Y_CONE for the cone wall).
#!
#! Why Cartesian (not cylindrical) coordinates for Case V.
#! MFiX 26.1.2 forbids combining `cartesian_grid = .True.` with
#! `coordinates = 'CYLINDRICAL'` (check_data_cartesian.f:55: "CARTESIAN GRID
#! OPTION NOT AVAILABLE WITH CYLINDRICAL COORDINATE SYSTEM").  Cut-cells,
#! STL geometry and quadric surfaces are therefore Cartesian-only features.
#! Since the 60 deg cone wall of this spouted bed cannot be represented on
#! a rectangular IJK grid in cylindrical coordinates without staircasing,
#! both Case V templates are built on Cartesian grids with cut-cells so
#! the cone profile is resolved cleanly.
#!
#! Why a Y_CONE quadric (not STL) for V_2d.  Native MFiX quadrics live under
#! the same `cartesian_grid=.True.` cut-cell machinery as STL but need no
#! external file.  For V_2d's planar slice the vessel inner wall reduces to
#! a single Y_CONE primitive; above the cone top the natural domain walls at
#! x = +/- R_c already serve as the cylindrical column walls, so no further
#! quadric is needed.  Quadrics are also compatible with `no_k = .True.`,
#! whereas STL is not (get_stl_data.f:813: "STL method valid only in 3D"),
#! so this template runs as a true 2D case with kmax = 1 rather than the
#! kmax = 2 slab that STL would require.  V_3d still uses STL because the
#! full axisymmetric vessel is a surface of revolution, not a single quadric.
#!
#! Every keyword below is documented in the MFiX 26.1.2 keyword reference.

### Run controls
  description = 'Day-9 V_2d spouting: U_in=8.697 m/s (1.20x U_ms,MG=0.9059 m/s via (Dc/Di)^2)'
  run_name    = 'V_2d_day9'
  units       = 'SI'
  run_type    = 'new'
  tstop       = 2.5
  dt          = 0.001
  dt_min      = 1.000000e-07
  dt_max      = 0.0001
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  drag_type   = 'GIDASPOW'
  drag_c1     = 0.8
  drag_d1     = 2.65
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (one Y_CONE quadric for the cone wall)
  cartesian_grid = .True.
  use_stl        = .False.
  n_quadric      = 1
  # Quadric 1: cone wall (Y-axis cone, internal flow).
  # Apex at (0, cone_apex_y_m, 0); half_angle = 30 deg (-> 60 deg included).
  # Clipped to 0 <= y <= cone_top_y_m; above the clip region the quadric is
  # inactive and the fluid fills the full column (fluid_in_clipped_region=T).
    quadric_form(1)             = 'Y_CONE'
    half_angle(1)               = 30.0
    t_x(1)                      = 0.0
    t_y(1)                      = -0.008227
    t_z(1)                      = 0.0
    clip_xmin(1)                = -0.038
    clip_xmax(1)                = 0.038
    clip_ymin(1)                = 0.0
    clip_ymax(1)                = 0.057632
    clip_zmin(1)                = -0.00059375
    clip_zmax(1)                = 0.00059375
    fluid_in_clipped_region(1)  = .True.
    bc_id_q(1)                  = 3

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = 100
  norm_g       = 0.0
  # SMART scheme for the six active equations.  Superbee (=2) combined with
  # multiple-equation set-up triggers a SIGBUS in the MFiX 26.1.2 cut-cell
  # preprocessor on this geometry (reproduced with 2-,6- and 9-element
  # discretize blocks); SMART (=3) is the next-up second-order limited
  # scheme and does not trigger the same code path.
  discretize(1) = 3
  discretize(2) = 3
  discretize(3) = 3
  discretize(4) = 3
  discretize(5) = 3
  discretize(6) = 3

### Geometry (cartesian 2D with no_k=.True.)
  coordinates = 'CARTESIAN'
  imax        = 32
  jmax        = 168
  kmax        = 1
  x_min       = -0.038
  x_max       = 0.038
  y_min       = 0.0
  y_max       = 0.4
  z_min       = -0.00059375
  z_max       = 0.00059375
  zlength     = 0.0011875
  no_k        = .True.

#### Fluid
  mu_g0      = 1.8542542630739353e-05
  mu_g_model = 'CONSTANT'
  ro_g0      = 1.1792423438936657

#### Solids
  mmax = 1
  # Solid 1: Case D ZrO2/YSZ surrogate
    solids_model(1) = 'TFM'
    d_p0(1)         = 0.00218
    ro_s0(1)        = 2400.0
    nmax_s(1)       = 0
    k_s0(1)         = 1.0
    ks_model(1)     = 'BAUER'

### Initial conditions
  # IC 1: Freeboard (gas only, above the packed bed)
    ic_x_w(1)    = -0.038
    ic_x_e(1)    = 0.038
    ic_y_s(1)    = 0.1
    ic_y_n(1)    = 0.4
    ic_z_b(1)    = -0.00059375
    ic_z_t(1)    = 0.00059375
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 293.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_p_star(1) = 0.0
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = 293.15
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: Packed bed, 0 <= y <= H_static (fills the vessel; cut-cells trim)
    ic_x_w(2)    = -0.038
    ic_x_e(2)    = 0.038
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = 0.1
    ic_z_b(2)    = -0.00059375
    ic_z_t(2)    = 0.00059375
    ic_ep_g(2)   = 0.5
    ic_t_g(2)    = 293.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_p_star(2) = 0.0
    ic_ep_s(2,1) = 0.5
    ic_t_s(2,1)  = 293.15
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0

  # IC 3: Pre-opened spout channel, |x| <= R_i through the bed.  Written AFTER
  # IC 2 so MFiX overrides the packed-bed values in this overlapping strip
  # (ic later -> higher precedence).  The gas is already present (ep_g = 1.0,
  # ep_s = 0.0) and flowing upward at bc_v_g, so the solver starts from a
  # quasi-steady spouted state instead of having to open the channel from a
  # cold packed bed on the first time step.  This is the standard startup
  # IC for TFM spouted-bed studies (San Jose et al. 2005; Du et al. 2006).
    ic_x_w(3)    = -0.00475
    ic_x_e(3)    = 0.00475
    ic_y_s(3)    = 0.0
    ic_y_n(3)    = 0.1
    ic_z_b(3)    = -0.00059375
    ic_z_t(3)    = 0.00059375
    ic_ep_g(3)   = 1.0
    ic_t_g(3)    = 293.15
    ic_u_g(3)    = 0.0
    ic_v_g(3)    = 8.696747094853258
    ic_w_g(3)    = 0.0
    ic_p_g(3)    = 101325.0
    ic_p_star(3) = 0.0
    ic_ep_s(3,1) = 0.0
    ic_t_s(3,1)  = 293.15
    ic_u_s(3,1)  = 0.0
    ic_v_s(3,1)  = 0.0
    ic_w_s(3,1)  = 0.0

# Boundary conditions
  # BC 1: Mass-inflow through the orifice strip (y = 0, |x| <= R_i)
    bc_type(1) = 'MI'
    bc_x_w(1)  = -0.00475
    bc_x_e(1)  = 0.00475
    bc_y_s(1)  = 0.0
    bc_y_n(1)  = 0.0
    bc_z_b(1)  = -0.00059375
    bc_z_t(1)  = 0.00059375
    bc_ep_g(1) = 1.0
    bc_p_g(1)  = 101325
    bc_t_g(1)  = 293.15
    bc_u_g(1)  = 0.0
    bc_v_g(1)  = 8.696747094853258
    bc_w_g(1)  = 0.0
    bc_ep_s(1,1) = 0.0
    bc_t_s(1,1)  = 293.15
    bc_u_s(1,1)  = 0.0
    bc_v_s(1,1)  = 0.0
    bc_w_s(1,1)  = 0.0

  # BC 2: Pressure-outflow at the top
    bc_type(2) = 'PO'
    bc_x_w(2)  = -0.038
    bc_x_e(2)  = 0.038
    bc_y_s(2)  = 0.4
    bc_y_n(2)  = 0.4
    bc_z_b(2)  = -0.00059375
    bc_z_t(2)  = 0.00059375
    bc_p_g(2)  = 101325

  # BC 3: Cut-cell (Y_CONE) no-slip wall. Bound to quadric 1 via bc_id_q.
    bc_type(3) = 'CG_NSW'
    bc_jj_ps(3) = 0
    bc_uw_g(3)  = 0.0
    bc_vw_g(3)  = 0.0
    bc_ww_g(3)  = 0.0

  bc_default_walls = .True.

# Monitors
  # Monitor 1: inlet-plane gas pressure (average over the orifice at y=0)
    monitor_type(1) = 4
    monitor_name(1) = 'V_2d_P_inlet'
    monitor_x_w(1)  = -0.00475
    monitor_x_e(1)  = 0.00475
    monitor_y_s(1)  = 0.0
    monitor_y_n(1)  = 0.0
    monitor_z_b(1)  = -0.00059375
    monitor_z_t(1)  = 0.00059375
    monitor_dt(1)   = 0.01
    monitor_p_g(1)  = .True.

  # Monitor 2: top-of-bed gas pressure (average across the full width at y = H_static)
    monitor_type(2) = 4
    monitor_name(2) = 'V_2d_P_top_bed'
    monitor_x_w(2)  = -0.038
    monitor_x_e(2)  = 0.038
    monitor_y_s(2)  = 0.1
    monitor_y_n(2)  = 0.1
    monitor_z_b(2)  = -0.00059375
    monitor_z_t(2)  = 0.00059375
    monitor_dt(2)   = 0.01
    monitor_p_g(2)  = .True.

  # Monitor 3: solids mass flux through a horizontal plane in the spout at
  # y = H_static/2, averaged over the spout core |x| <= R_i.  Flux is
  # reconstructed in post as rho_s * ep_s * v_s * A_spout from monitored ep_s/v_s.
    monitor_type(3) = 4
    monitor_name(3) = 'V_2d_spout_mid'
    monitor_x_w(3)  = -0.00475
    monitor_x_e(3)  = 0.00475
    monitor_y_s(3)  = 0.05
    monitor_y_n(3)  = 0.05
    monitor_z_b(3)  = -0.00059375
    monitor_z_t(3)  = 0.00059375
    monitor_dt(3)   = 0.01
    monitor_ep_s(3,1) = .True.
    monitor_v_s(3,1)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: whole domain (cell-centred, ep_g / P_g / vel_g / vel_s)
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = -0.038
    vtk_x_e(1)      = 0.038
    vtk_y_s(1)      = 0.0
    vtk_y_n(1)      = 0.4
    vtk_z_b(1)      = -0.00059375
    vtk_z_t(1)      = 0.00059375
    vtk_data(1)     = 'C'
    vtk_dt(1)       = 0.05
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.
    vtk_vel_s(1,1)  = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'
  resid_string(4) = 'P1'
  resid_string(5) = 'U1'
  resid_string(6) = 'V1'

### Two-fluid model closure (Day-5 tutorial / fb_sweep defaults).
### ep_star = 0.37 is the TFM min-gas-fraction (max solids packing)
### and comes from params/particles.yaml case_D.ep_star -- a particle
### property, not a numerical knob. Physical basis: random close packing
### of monodisperse 500 um smooth spheres eps_s,RCP ~ 0.636 (Scott &
### Kilgour 1969; Gidaspow 1994 Ch. 2). Threshold 1 - ep_star =
### 0.63 sits ~3% above the IC bed value
### eps_s_bed = 0.5 (slightly tight RLP), so Schaeffer
### frictional stress is inactive at t = 0 by physics, not numerical
### tuning. Same value is used across V_2d, V_3d, and fb_sweep.
  c_e            = 0.9
  c_f            = 0.1
  ep_star        = 0.37
  friction_model = 'SCHAEFFER'
  kt_type        = 'ALGEBRAIC'
  phi            = 26.0
  phi_w          = 11.3
  rdf_type       = 'CARNAHAN_STARLING'
