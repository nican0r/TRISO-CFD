#! Generated by src/make_case.py (Day 8 - Case V UTK/ORNL 2D template).
#! Coordinates: cartesian, cartesian_grid=.True., no_k=.True.,
#!              use_stl=.False., n_quadric=1 (Y_CONE for the cone wall).
#!
#! Why a planar quadric cut-cell slab (not axisymmetric cylindrical).
#! MFiX 26.1.2 forbids `cartesian_grid = .True.` with
#! `coordinates = 'CYLINDRICAL'` (check_data_cartesian.f: "CARTESIAN GRID
#! OPTION NOT AVAILABLE WITH CYLINDRICAL COORDINATE SYSTEM"), so option (a)
#! in implementation-steps/day-8.md (axisymmetric with stair-stepped cone)
#! cannot carry a RESOLVED sloped cone wall under documented keywords.
#! Option (b) is used here (planar slab with the cone defined by a native
#! Y_CONE quadric). Results from a planar slab are to be treated as
#! qualitative; a 3D cut-cell/STL run (Day 10) is required for validation.
#!
#! Every keyword below has been confirmed against init_namelist.f in the
#! installed MFiX 26.1.2 reference (CLAUDE.md rule 1).

### Run controls
  description = 'Day 9 V_2d smoke test (ORNL/UTK Case V)'
  run_name    = 'V_2d_day9'
  units       = 'SI'
  run_type    = 'new'
  tstop       = 3.0
  dt          = 0.0001
  dt_min      = 1.000000e-07
  dt_max      = 0.001
  dt_fac      = 0.9
  res_dt      = 0.01
  chk_batchq_end = .True.
  drag_type   = 'SYAM_OBRIEN'
  drag_c1     = 0.8
  drag_d1     = 2.65
  energy_eq   = .False.
  momentum_x_eq(0) = .True.
  momentum_y_eq(0) = .True.
  momentum_z_eq(0) = .True.
  species_eq(0) = .False.
  species_eq(1) = .False.

### Cartesian cut-cell grid (one Y_CONE quadric for the cone wall)
  cartesian_grid = .True.
  use_stl        = .False.
  n_quadric      = 1
  # Quadric 1: cone wall (Y-axis cone, internal flow).
  # Apex at (0, cone_apex_y_m, 0); half_angle = 30 deg (-> 60 deg included).
  # Clipped to 0 <= y <= cone_top_y_m; above the clip region the quadric is
  # inactive and the fluid fills the full column (fluid_in_clipped_region=T).
    quadric_form(1)             = 'Y_CONE'
    half_angle(1)               = 30.0
    t_x(1)                      = 0.0
    t_y(1)                      = -0.0034641016151377556
    t_z(1)                      = 0.0
    clip_xmin(1)                = -0.025
    clip_xmax(1)                = 0.025
    clip_ymin(1)                = 0.0
    clip_ymax(1)                = 0.03983716857408419
    clip_zmin(1)                = -0.0005
    clip_zmax(1)                = 0.0005
    fluid_in_clipped_region(1)  = .True.
    bc_id_q(1)                  = 3

### Physical parameters
  gravity_x = 0.0
  gravity_y = -9.80665
  gravity_z = 0.0

### Numeric
  detect_stall = .True.
  max_nit      = 50
  norm_g       = 0.0

### Geometry (cartesian 2D with no_k=.True.)
  coordinates = 'CARTESIAN'
  imax        = 50
  jmax        = 200
  kmax        = 1
  x_min       = -0.025
  x_max       = 0.025
  y_min       = 0.0
  y_max       = 0.2
  z_min       = -0.0005
  z_max       = 0.0005
  zlength     = 0.001
  no_k        = .True.

#### Fluid
  mu_g0      = 1.8542542630739353e-05
  mu_g_model = 'CONSTANT'
  ro_g0      = 1.1792423438936657

#### Solids
  mmax = 1
  # Solid 1: ORNL/UTK Case V ZrO2 (500 um, 6050 kg/m^3)
    solids_model(1) = 'TFM'
    d_p0(1)         = 0.0005
    ro_s0(1)        = 6050.0
    nmax_s(1)       = 0
    k_s0(1)         = 1.0
    ks_model(1)     = 'BAUER'

### Initial conditions
  # IC 1: Freeboard (gas only, above the packed bed)
    ic_x_w(1)    = -0.025
    ic_x_e(1)    = 0.025
    ic_y_s(1)    = 0.032188056502491236
    ic_y_n(1)    = 0.2
    ic_z_b(1)    = -0.0005
    ic_z_t(1)    = 0.0005
    ic_ep_g(1)   = 1.0
    ic_t_g(1)    = 293.15
    ic_u_g(1)    = 0.0
    ic_v_g(1)    = 0.0
    ic_w_g(1)    = 0.0
    ic_p_g(1)    = 101325.0
    ic_p_star(1) = 0.0
    ic_ep_s(1,1) = 0.0
    ic_t_s(1,1)  = 293.15
    ic_u_s(1,1)  = 0.0
    ic_v_s(1,1)  = 0.0
    ic_w_s(1,1)  = 0.0

  # IC 2: Packed bed, 0 <= y <= H_static (fills the vessel; cut-cells trim).
  # eps_s_bed = 0.57 sits below 1 - ep_star = 0.58 so
  # the Schaeffer frictional-stress term is inactive at t = 0.
    ic_x_w(2)    = -0.025
    ic_x_e(2)    = 0.025
    ic_y_s(2)    = 0.0
    ic_y_n(2)    = 0.032188056502491236
    ic_z_b(2)    = -0.0005
    ic_z_t(2)    = 0.0005
    ic_ep_g(2)   = 0.43000000000000005
    ic_t_g(2)    = 293.15
    ic_u_g(2)    = 0.0
    ic_v_g(2)    = 0.0
    ic_w_g(2)    = 0.0
    ic_p_star(2) = 0.0
    ic_ep_s(2,1) = 0.57
    ic_t_s(2,1)  = 293.15
    ic_u_s(2,1)  = 0.0
    ic_v_s(2,1)  = 0.0
    ic_w_s(2,1)  = 0.0

  # IC 3: Pre-opened spout channel, |x| <= R_i through the bed.  Written
  # AFTER IC 2 so MFiX overrides the packed-bed values in this overlapping
  # strip. The gas is already present (ep_g = 1.0) and flowing upward at
  # bc_v_g, so the solver starts from a quasi-steady spouted state instead
  # of having to open the channel from a cold packed bed on the first time
  # step (standard startup IC for TFM spouted-bed studies; San Jose et al.
  # 2005, Du et al. 2006).
    ic_x_w(3)    = -0.002
    ic_x_e(3)    = 0.002
    ic_y_s(3)    = 0.0
    ic_y_n(3)    = 0.032188056502491236
    ic_z_b(3)    = -0.0005
    ic_z_t(3)    = 0.0005
    ic_ep_g(3)   = 1.0
    ic_t_g(3)    = 293.15
    ic_u_g(3)    = 0.0
    ic_v_g(3)    = 30.0
    ic_w_g(3)    = 0.0
    ic_p_g(3)    = 101325.0
    ic_p_star(3) = 0.0
    ic_ep_s(3,1) = 0.0
    ic_t_s(3,1)  = 293.15
    ic_u_s(3,1)  = 0.0
    ic_v_s(3,1)  = 0.0
    ic_w_s(3,1)  = 0.0

# Boundary conditions
  # BC 1: Mass-inflow through the orifice strip (y = 0, |x| <= R_i)
    bc_type(1) = 'MI'
    bc_x_w(1)  = -0.002
    bc_x_e(1)  = 0.002
    bc_y_s(1)  = 0.0
    bc_y_n(1)  = 0.0
    bc_z_b(1)  = -0.0005
    bc_z_t(1)  = 0.0005
    bc_ep_g(1) = 1.0
    bc_p_g(1)  = 101325
    bc_t_g(1)  = 293.15
    bc_u_g(1)  = 0.0
    bc_v_g(1)  = 30.0
    bc_w_g(1)  = 0.0
    bc_ep_s(1,1) = 0.0
    bc_t_s(1,1)  = 293.15
    bc_u_s(1,1)  = 0.0
    bc_v_s(1,1)  = 0.0
    bc_w_s(1,1)  = 0.0

  # BC 2: Pressure-outflow at the top
    bc_type(2) = 'PO'
    bc_x_w(2)  = -0.025
    bc_x_e(2)  = 0.025
    bc_y_s(2)  = 0.2
    bc_y_n(2)  = 0.2
    bc_z_b(2)  = -0.0005
    bc_z_t(2)  = 0.0005
    bc_p_g(2)  = 101325

  # BC 3: Cut-cell (Y_CONE) no-slip wall. Bound to quadric 1 via bc_id_q.
    bc_type(3) = 'CG_NSW'
    bc_jj_ps(3) = 0
    bc_uw_g(3)  = 0.0
    bc_vw_g(3)  = 0.0
    bc_ww_g(3)  = 0.0

  bc_default_walls = .True.

# Monitors (1 kHz sampling matches S1 and S2's 1000 Hz experimental sampling)
  # Monitor 1: inlet-plane gas pressure, averaged over |x| <= R_i at y = 0.
  # Tap location is not reported in S1 or S2; assumed at the inlet plane.
    monitor_type(1) = 4
    monitor_name(1) = 'V_2d_P_inlet'
    monitor_x_w(1)  = -0.002
    monitor_x_e(1)  = 0.002
    monitor_y_s(1)  = 0.0
    monitor_y_n(1)  = 0.0
    monitor_z_b(1)  = -0.0005
    monitor_z_t(1)  = 0.0005
    monitor_dt(1)   = 0.001
    monitor_p_g(1)  = .True.

  # Monitor 2: top-of-bed gas pressure (across the full width at y = H_static)
    monitor_type(2) = 4
    monitor_name(2) = 'V_2d_P_top_bed'
    monitor_x_w(2)  = -0.025
    monitor_x_e(2)  = 0.025
    monitor_y_s(2)  = 0.032188056502491236
    monitor_y_n(2)  = 0.032188056502491236
    monitor_z_b(2)  = -0.0005
    monitor_z_t(2)  = 0.0005
    monitor_dt(2)   = 0.001
    monitor_p_g(2)  = .True.

  # Monitor 3: domain-integrated solids inventory (volume integral of ep_s).
  # monitor_type = 11 is "Volume integral (cell)" per init_namelist.f.
    monitor_type(3) = 11
    monitor_name(3) = 'V_2d_solids_inventory'
    monitor_x_w(3)  = -0.025
    monitor_x_e(3)  = 0.025
    monitor_y_s(3)  = 0.0
    monitor_y_n(3)  = 0.2
    monitor_z_b(3)  = -0.0005
    monitor_z_t(3)  = 0.0005
    monitor_dt(3)   = 0.001
    monitor_ep_s(3,1) = .True.

  # Monitor 4: centerline gas velocity probe at mid-bed height (y = H_mid).
  # monitor_type = 4 "Arithmetic average over region (cell)" averages v_g over
  # a thin x-strip at the spout centerline. On Day 10 the centerline profile
  # for S1 Fig. 1 validation is reconstructed from VTU snapshots; this
  # single-point time trace is a Day-9 smoke-test probe.
    monitor_type(4) = 4
    monitor_name(4) = 'V_2d_centerline_vg'
    monitor_x_w(4)  = -0.002
    monitor_x_e(4)  = 0.002
    monitor_y_s(4)  = 0.016094028251245618
    monitor_y_n(4)  = 0.016094028251245618
    monitor_z_b(4)  = -0.0005
    monitor_z_t(4)  = 0.0005
    monitor_dt(4)   = 0.001
    monitor_v_g(4)  = .True.

# VTK outputs
  write_vtk_files         = .True.
  time_dependent_filename = .True.
  # VTK 1: whole domain (cell-centred, ep_g / P_g / vel_g / vel_s)
    vtk_filebase(1) = 'Background'
    vtk_x_w(1)      = -0.025
    vtk_x_e(1)      = 0.025
    vtk_y_s(1)      = 0.0
    vtk_y_n(1)      = 0.2
    vtk_z_b(1)      = -0.0005
    vtk_z_t(1)      = 0.0005
    vtk_data(1)     = 'C'
    vtk_dt(1)       = 0.05
    vtk_nxs(1)      = 0
    vtk_nys(1)      = 0
    vtk_nzs(1)      = 0
    vtk_ep_g(1)     = .True.
    vtk_p_g(1)      = .True.
    vtk_vel_g(1)    = .True.
    vtk_vel_s(1,1)  = .True.

# SPx outputs
  spx_dt(1) = 0.1
  spx_dt(2) = 0.1
  spx_dt(3) = 0.1
  spx_dt(4) = 0.1
  spx_dt(5) = 0.1
  spx_dt(6) = 0.1
  spx_dt(7) = 0.1
  spx_dt(8) = 0.1
  spx_dt(9) = 0.1

### Residuals
  resid_string(1) = 'P0'
  resid_string(2) = 'U0'
  resid_string(3) = 'V0'
  resid_string(4) = 'P1'
  resid_string(5) = 'U1'
  resid_string(6) = 'V1'

### Two-fluid-model closures (S1 Table 1)
### ep_star = 0.42 is the TFM min-gas-fraction (= void fraction at
### minimum fluidization per S1 Table 1). Threshold 1 - ep_star =
### 0.58 sits above the IC bed value eps_s_bed =
### 0.57 so Schaeffer frictional stress is inactive at t = 0 by
### physics (not numerical tuning). c_e = 0.9 is assumed (not reported
### in S1 or S2); listed as an open item for the Day 13 sensitivity study.
  c_e               = 0.9
  c_f               = 0.1
  ep_star           = 0.42
  friction_model    = 'SCHAEFFER'
  blending_function = 'GIDASPOW_PCF'
  kt_type           = 'LUN_1984'
  phi               = 15.0
  phi_w             = 11.3
  rdf_type          = 'CARNAHAN_STARLING'
