# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
# .venv is a symlink to .venv.nosync; a trailing-slash rule would not match it.
.venv
.venv.nosync/
.venv.evicted/
venv/

# MFiX / raw simulation output (CLAUDE.md rule 7 — keep raw output out of git)
cases/**/*.RES
cases/**/*.SP*
cases/**/*.LOG
cases/**/*.OUT
cases/**/*.pvd
cases/**/*.vtu
cases/**/*.vtp
cases/**/*.vtk
cases/**/BACKUP*
cases/**/POST_*.dat
cases/**/run.log
cases/**/mfix.dat
cases/**/*.pid
cases/**/*.msh
cases/**/MESH_STATS.LOG
cases/**/VTU_FRAME_INDEX.TXT
cases/**/*_FACETS_READ.stl
cases/**/*_FACETS_IGNORED.stl
# STL input files are generated deterministically by src/make_stl.py.
cases/**/geometry_*.stl
cases/**/*_boundary.vtk
cases/**/*_MESH.vtu
cases/**/*.TXT
cases/**/EPgErr.log
cases/**/*.csv

# Editors / OS
.DS_Store
.vscode/
.idea/

# AWS Batch downloads: aws_out/ echoes the case inputs next to the raw output
cases/**/aws_out/
cases/**/.wall_start
cases/**/.wall_end

# Local state and reference material (not project source)
.claude/worktrees/
.claude/scheduled_tasks.lock
.firecrawl/
/*.pdf

# PIVlab frame export (raw rendered frames and PIVlab outputs; src/post/piv_c26_export_frames.py)
results/pivlab_export/
results/parcel_truth/

# Primary results only (user decision 2026-10-29; README.md "Primary results"):
# the C26 c01-c09 sweeps with the 2x2 tip source (*_apex_v232) and the
# single-cell bore source (*_fullface_bore_mom_nointerp_v232, sweep tag
# fullface_nointerp_v232), plus the PIVlab re-run of the 2x2 c01-c03.
# Every other results/ file stays local, untracked. Add a negation here
# when a new run becomes a primary result.
results/*
!results/run_log.csv
!results/*_apex_v232*
!results/*_fullface_bore_mom_nointerp_v232*
!results/*_fullface_nointerp_v232*
!results/c26_pivlab_rerun*.csv
!results/fig_c26_pivlab_*.png
